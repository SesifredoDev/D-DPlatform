{
  "name": "astral-project",
  "version": "1.0.5",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "npm run build && electron .",
    "electron:dev": "concurrently \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:prepare-ffmpeg": "node scripts/prepare-ffmpeg-bundle.mjs",
    "tauri:build": "tauri build"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/cdk": "^21.0.5",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.0.5",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fontsource/material-icons": "^5.2.7",
    "@milkdown/core": "^7.20.0",
    "@milkdown/crepe": "^7.20.0",
    "@milkdown/ctx": "^7.20.0",
    "@milkdown/plugin-cursor": "^7.20.0",
    "@milkdown/plugin-history": "^7.20.0",
    "@milkdown/plugin-indent": "^7.20.0",
    "@milkdown/plugin-listener": "^7.20.0",
    "@milkdown/preset-gfm": "^7.20.0",
    "@milkdown/theme-nord": "^7.20.0",
    "@milkdown/transformer": "^7.20.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-updater": "2.12.0",
    "electron-json-storage": "^4.6.0",
    "idb-keyval": "^6.2.2",
    "konva": "^10.2.0",
    "livekit-client": "^2.18.0",
    "livekit-server-sdk": "^2.15.0",
    "mediasoup-client": "^3.18.3",
    "ng2-pdf-viewer": "^10.4.0",
    "ngx-electron": "^2.2.0",
    "ngx-markdown": "^21.0.1",
    "rehype-raw": "^7.0.0",
    "rxjs": "~7.8.0",
    "simple-peer": "^9.11.1",
    "socket.io-client": "^4.8.3",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/simple-peer": "^9.11.9",
    "concurrently": "^9.2.1",
    "electron": "github:castlabs/electron-releases#v22.3.27+wvcus",
    "electronmon": "^2.0.4",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
