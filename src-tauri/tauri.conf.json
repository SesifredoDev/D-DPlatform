{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astral Project",
  "version": "0.0.0",
  "identifier": "com.astralproject.desktop",
  "build": {
    "frontendDist": "../dist/astral-project/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Astral Project",
        "url": "astralproject://localhost/index.html",
        "width": 1900,
        "height": 1080,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "bin/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
