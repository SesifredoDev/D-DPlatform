{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astral Project",
  "version": "1.0.4",
  "identifier": "com.astralproject.desktop",
  "build": {
    "frontendDist": "../dist/astral-project/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm run start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Astral Project",
        "url": "astralproject://localhost/index.html",
        "width": 1900,
        "height": 1080,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "useHttpsScheme": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/recordings/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "bin/"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4NzBBOTcxNjdBQzlENEUKUldST25heG5jYWx3cUtKNjhtZTdVWjBkZFVqOXlkRkE5WVNGamhpZ1NaQXB6OXlxeklOQTF3cEIK",
      "endpoints": [
        "https://dissertation.pchaffey.me/api/desktop-updates/latest?target={{target}}&arch={{arch}}&current_version={{current_version}}"
      ]
    }
  }
}
