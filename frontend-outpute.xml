            background: var(--obsidian-surface-alt);
            border: 1px solid var(--obsidian-border-soft);
            border-radius: 12px;

            mat-icon {
              color: var(--obsidian-text-faint);
            }

            input {
              width: 100%;
              background: transparent;
              border: none;
              outline: none;
              color: var(--obsidian-text-strong);
              font-size: 0.95rem;

              &::placeholder {
                color: var(--obsidian-text-faint);
              }
            }
          }

          .resource-picker-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            max-height: 280px;
            overflow-y: auto;
            padding-right: 0.25rem;
          }

          .resource-item {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            width: 100%;
            padding: 0.8rem 0.9rem;
            border: 1px solid var(--obsidian-border-faint);
            border-radius: 12px;
            background: var(--obsidian-surface-alt);
            color: var(--obsidian-text);
            text-align: left;
            cursor: pointer;

            &:hover {
              border-color: var(--obsidian-accent-strong);
              background: var(--obsidian-accent-soft);
            }

            mat-icon {
              color: var(--obsidian-accent);
            }

            .resource-item-text {
              display: flex;
              flex-direction: column;
              gap: 0.15rem;
              min-width: 0;
            }

            .resource-name {
              color: var(--obsidian-text-strong);
              font-weight: 600;
            }

            .resource-path {
              color: var(--obsidian-text-dim);
              font-size: 0.86rem;
              overflow: hidden;
              text-overflow: ellipsis;
            }
          }

          .resource-picker-empty {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 1rem 0.25rem 0.25rem;
            color: var(--obsidian-text-dim);

            mat-icon {
              color: var(--obsidian-text-faint);
            }

            p {
              margin: 0;
            }
          }
        }

        textarea {
          flex: 1;
          min-height: 420px;
          background: var(--obsidian-surface);
          color: var(--obsidian-text);
          border: 1px solid var(--obsidian-border-soft);
          border-radius: var(--obsidian-radius-lg);
          padding: 1.25rem;
          font-family: var(--font-family-main);
          font-size: 16px;
          line-height: 1.7;
          resize: vertical;
          outline: none;
          box-shadow: inset 0 1px 0 var(--obsidian-border-faint);

          &:focus {
            border-color: var(--obsidian-accent-strong);
            box-shadow: 0 0 0 3px var(--obsidian-accent-soft);
          }

          &::placeholder {
            color: var(--obsidian-text-faint);
          }
        }
      }

      /* Non-markdown viewer */
      .non-markdown-viewer {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 2rem;
        background-color: var(--obsidian-bg);
        overflow: auto;

        .viewer-image {
          max-width: 100%;
          max-height: 80vh;
          object-fit: contain;
          border-radius: var(--radius-m);
        }

        .viewer-pdf {
          width: 100%;
          height: 80vh;
          border: none;
        }

        .generic-file {
          text-align: center;
          mat-icon {
            font-size: 64px;
            width: 64px;
            height: 64px;
            opacity: 0.5;
            margin-bottom: 1rem;
          }
          p {
            font-size: 1.2rem;
            margin-bottom: 1.5rem;
          }
        }
      }
    }
  }
}

@media (max-width: 1100px) {
  .obsidian-view-container {
    .obsidian-main-content {
      .obsidian-sidebar {
        width: 280px;
        min-width: 280px;
      }

      .obsidian-editor-container {
        .file-content-wrapper {
          .file-name-bar,
          .editor-toolbar {
            padding-left: 1rem;
            padding-right: 1rem;
          }
        }

        .preview-mode {
          padding-left: 1rem;
          padding-right: 1rem;
        }

        .editor-mode {
          padding-left: 1rem;
          padding-right: 1rem;

          .editor-guidance {
            .tip-grid {
              grid-template-columns: 1fr;
            }
          }

          .resource-picker {
            .resource-picker-header {
              flex-direction: column;
            }
          }
        }
      }
    }
  }
}
