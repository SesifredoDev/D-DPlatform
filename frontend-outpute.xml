    &.active { background: var(--brand-blue-alpha); border-color: var(--brand-blue); }

    .emoji { font-size: 14px; }
    .count { font-weight: 600; color: var(--on-surface-muted); }
  }
}

/* =================================
   MESSAGE ACTIONS (HOVER)
================================= */

.message-actions {
  position: absolute;
  top: 0;
  right: 16px;
  transform: translateY(-40%) scale(0.95);
  display: flex;
  gap: 4px;
  background: rgba(30, 31, 34, 0.95);
  backdrop-filter: blur(8px);
  border: 1px solid var(--outline);
  border-radius: var(--radius-m);
  padding: 2px 4px;
  opacity: 0;
  z-index: 10;
  transition: all 0.2s cubic-bezier(0.18, 0.89, 0.32, 1.28);
  box-shadow: var(--shadow-2);

  .action-btn {
    width: 32px;
    height: 32px;
    line-height: 32px;
    color: var(--on-surface-muted);
    mat-icon { font-size: 18px; width: 18px; height: 18px; }
    &:hover { color: var(--brand-blue); background: rgba(255, 255, 255, 0.05); }
  }
}

.emoji-picker-mini {
  display: flex;
  padding: 4px;
  button {
    font-size: 20px;
    padding: 4px;
    min-width: 40px;
  }
}

/* =================================
   INPUT CONTAINER
================================= */

.input-container {
  padding: 16px 24px 24px 24px;
  background: transparent;
  position: relative;
  z-index: 5;
}

.reply-preview, .whisper-preview {
  background: rgba(43, 45, 49, 0.8);
  border-top-left-radius: 12px;
  border-top-right-radius: 12px;
  border: 1px solid var(--outline);
  border-bottom: none;
  padding: 8px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  color: var(--on-surface-muted);

