.message-item {
  display: flex;
  gap: 16px;
  padding: 8px 16px;
  border-radius: var(--radius-m);
  position: relative;
  transition: all 0.1s ease;
  min-height: 44px;

  &:hover {
    background: rgba(255, 255, 255, 0.03);
    .message-actions { opacity: 1; transform: translateY(-50%) scale(1); }
    .timestamp { opacity: 1; }
  }
