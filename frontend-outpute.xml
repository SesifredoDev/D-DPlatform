              <div class="ac-input-wrapper">
                <mat-icon class="ac-icon">shield</mat-icon>
                <div class="ac-fields">
                  <label>ARMOR CLASS</label>
                  <input type="number" formControlName="ac" placeholder="10">
                </div>
              </div>
            </div>

            <h3 class="pane-title">Ability Scores</h3>
            <div class="stats-grid">
              @for (stat of ['strength', 'dexterity', 'constitution', 'intelligence', 'wisdom', 'charisma']; track stat) {
                <div class="stat-card">
                  <label>{{ stat | slice:0:3 | uppercase }}</label>
                  <input type="number" [formControlName]="stat">
                  <div class="stat-mod">{{ modifier(charForm.get(stat)?.value || 10) }}</div>
                </div>
              }
            </div>
          </div>
        </mat-tab>

        <!-- 3. VOCATIONS -->
        <mat-tab>
          <ng-template mat-tab-label>
            <mat-icon>menu_book</mat-icon>
            <span>Vocations</span>
          </ng-template>

          <div class="tab-pane">
            <header class="section-action-header">
              <p>Manage your multiclassing levels.</p>
              <button mat-button class="add-class-btn" type="button" (click)="addClass()">
                <mat-icon>add</mat-icon> ADD CLASS
              </button>
            </header>

            <div formArrayName="classes" class="class-cards-list">
              @for (c of classArray.controls; track $index; let i = $index) {
                <div [formGroupName]="i" class="class-glass-card">
                  <div class="card-inputs">
                    <mat-form-field appearance="fill" class="compact-field flex-2">
                      <mat-label>Class</mat-label>
                      <input matInput formControlName="className" placeholder="Warlock">
                    </mat-form-field>

                    <mat-form-field appearance="fill" class="compact-field flex-2">
                      <mat-label>Subclass</mat-label>
                      <input matInput formControlName="subclassName" placeholder="Archfey">
                    </mat-form-field>

                    <mat-form-field appearance="fill" class="compact-field flex-1">
                      <mat-label>Lv</mat-label>
                      <input matInput type="number" formControlName="level">
                    </mat-form-field>
                  </div>

                  <button mat-icon-button color="warn" (click)="removeClass(i)" class="delete-card-btn">
                    <mat-icon>delete_outline</mat-icon>
                  </button>
                </div>
              }

              @if (classArray.length === 0) {
                <div class="empty-state-glass">
                  <mat-icon>history_edu</mat-icon>
                  <p>No classes added yet.</p>
                </div>
              }
            </div>
          </div>
        </mat-tab>

        <!-- 4. VISUALS -->
        <mat-tab>
          <ng-template mat-tab-label>
            <mat-icon>image</mat-icon>
            <span>Media</span>
          </ng-template>

          <div class="tab-pane">
            <div class="media-upload-grid">

              <div class="upload-zone glass" [class.has-file]="charForm.get('iconUrl')?.value">
                <div class="upload-preview">
                  @if (charForm.get('iconUrl')?.value) {
                    <img [src]="charForm.get('iconUrl')?.value" class="preview-img">
                  } @else {
                    <mat-icon>portrait</mat-icon>
                  }
                </div>
                <div class="upload-info">
                  <label>Profile Icon</label>
                  <span>Select an avatar image</span>
                  <input type="file" (change)="onFileSelected($event, 'icon')" accept="image/*">
                </div>
              </div>

              <div class="upload-zone glass">
                <mat-icon class="pdf-icon">picture_as_pdf</mat-icon>
                <div class="upload-info">
                  <label>Character PDF</label>
                  <span>Full character sheet (optional)</span>
                  <input type="file" (change)="onFileSelected($event, 'pdf')" accept="application/pdf">
                </div>
              </div>

            </div>
          </div>
        </mat-tab>

      </mat-tab-group>
    </form>
  </mat-dialog-content>

  <footer class="dialog-footer">
    <button mat-button class="btn-cancel" (click)="close()">CANCEL</button>
    <button mat-raised-button class="btn-summon" (click)="submitForm()" [disabled]="charForm.invalid">
      <mat-icon>auto_awesome</mat-icon>
      <span>SUMMON CHARACTER</span>
    </button>
  </footer>

</div>
