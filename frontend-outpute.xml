import { Component, Inject, OnInit } from '@angular/core';
import { FormArray, FormBuilder, FormGroup, ReactiveFormsModule, Validators } from '@angular/forms';
import { MAT_DIALOG_DATA, MatDialogModule, MatDialogRef } from '@angular/material/dialog';
import { CommonModule } from '@angular/common';
import { CharacterService } from '../../../shared/services/character/character';
import { MatFormFieldModule } from '@angular/material/form-field';
import { MatInputModule } from '@angular/material/input';
import { MatButtonModule, MatIconButton } from '@angular/material/button';
import { MatIconModule } from '@angular/material/icon';
import { MatTabsModule } from '@angular/material/tabs';
import { ICharacter } from '../../../shared/models/user/character.model';
import { MatDividerModule } from '@angular/material/divider';
import { MatTooltipModule } from '@angular/material/tooltip';

@Component({
  selector: 'app-edit',
  standalone: true,
  imports: [
    CommonModule, ReactiveFormsModule, MatDialogModule,
    MatFormFieldModule, MatInputModule, MatButtonModule, MatIconButton,
    MatIconModule, MatTabsModule, MatDividerModule, MatTooltipModule
  ],
  templateUrl: './edit.html',
  styleUrl: './edit.scss'
})
export class Edit implements OnInit {
  charForm: FormGroup;
  selectedIcon: File | null = null;
  selectedPdf: File | null = null;

  constructor(
    private fb: FormBuilder,
    private charService: CharacterService,
    private dialogRef: MatDialogRef<Edit>,
    @Inject(MAT_DIALOG_DATA) public data: ICharacter
  ) {
    this.charForm = this.fb.group({
      _id: [data._id],
      name: [data.name, Validators.required],
      race: [data.race, Validators.required],
      ac: [data.ac, [Validators.required, Validators.min(0)]],
      ddbId: [data.ddbId],
      iconUrl: [data.icon],
      strength: [data.baseStats?.strength || 10],
      dexterity: [data.baseStats?.dexterity || 10],
      constitution: [data.baseStats?.constitution || 10],
      intelligence: [data.baseStats?.intelligence || 10],
      wisdom: [data.baseStats?.wisdom || 10],
      charisma: [data.baseStats?.charisma || 10],
      classes: this.fb.array([])
    });
  }

  ngOnInit(): void {
    if (this.data.classes) {
      this.data.classes.forEach(c => this.addClass(c.className, c.subclassName, c.level));
    }
  }

  get classArray() { return this.charForm.get('classes') as FormArray; }

  addClass(className = '', subclassName = '', level = 1) {
    const classGroup = this.fb.group({
      className: [className, Validators.required],
      subclassName: [subclassName],
      level: [level, [Validators.required, Validators.min(1)]]
    });
    this.classArray.push(classGroup);
  }

  removeClass(index: number) { this.classArray.removeAt(index); }

  modifier(stat: number): string {
    const mod = Math.floor((stat - 10) / 2);
    return mod >= 0 ? `+${mod}` : `${mod}`;
  }

  onFileSelected(event: any, type: 'icon' | 'pdf') {
    const file = event.target.files[0];
    if (!file) return;

    if (type === 'icon') {
      this.selectedIcon = file;
      const reader = new FileReader();
      reader.onload = (e: any) => this.charForm.patchValue({ iconUrl: e.target.result });
      reader.readAsDataURL(file);
    }
    if (type === 'pdf') {
      this.selectedPdf = file;
    }
  }

  submitForm() {
    if (this.charForm.valid) {
      const formVal = this.charForm.value;
      const characterUpdate: Partial<ICharacter> = {
        _id: formVal._id,
        name: formVal.name,
        race: formVal.race,
        ac: formVal.ac,
        ddbId: formVal.ddbId,
        icon: formVal.iconUrl,
        baseStats: {
          strength: formVal.strength,
          dexterity: formVal.dexterity,
          constitution: formVal.constitution,
          intelligence: formVal.intelligence,
          wisdom: formVal.wisdom,
          charisma: formVal.charisma
        },
        classes: formVal.classes
      };

      if (!characterUpdate._id) return;
      this.charService.updateCharacter(characterUpdate._id, characterUpdate, this.selectedIcon!, this.selectedPdf!)
        .subscribe(res => {
          this.dialogRef.close(res);
        });
    }
  }

  close() { this.dialogRef.close(); }
}
</file>

<file path="src/app/pages/character/manage/manage.scss">
/* ================================
   CHARACTER MANAGEMENT (MODERN GLASS)
================================ */

.glass-management-container {
  padding: var(--space-l);
  max-width: 1400px;
  margin: var(--space-m) auto;
  background: rgba(30, 31, 34, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--outline);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-4);
  color: var(--on-background);
  display: flex;
  flex-direction: column;
  min-height: 80vh;
}

/* --- Header --- */
.management-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: var(--space-l);
  margin-bottom: var(--space-l);
  border-bottom: 1px solid var(--outline);

  .header-content {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    .title-icon { font-size: 32px; width: 32px; height: 32px; color: var(--brand-blue); }
    .management-title { margin: 0; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; color: white; }
  }

  .header-actions {
    display: flex;
    gap: var(--space-s);
    .btn-new-char {
      background: var(--brand-blue); color: white; font-weight: 700;
      padding: 0 var(--space-l); border-radius: var(--radius-l);
      &:hover { background: var(--brand-blue-hover); transform: translateY(-2px); box-shadow: 0 4px 15px rgba(114, 137, 218, 0.4); }
    }
    .btn-close-manager {
      color: var(--on-surface-muted);
      &:hover { background: rgba(255,255,255,0.05); color: white; }
    }
  }
}

/* --- Character Grid --- */
.character-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: var(--space-l);
  padding-bottom: var(--space-l);
}

.character-glass-card {
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid var(--outline);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-2);
  display: flex;
  flex-direction: column;
  transition: all 0.2s ease;
  overflow: hidden;

  &:hover {
    transform: translateY(-4px);
    border-color: var(--brand-blue-alpha);
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
    background: rgba(255, 255, 255, 0.05);
  }

  &.active-card {
    border-color: var(--brand-blue);
    box-shadow: 0 0 20px rgba(114, 137, 218, 0.5);
    background: rgba(114, 137, 218, 0.05);
  }
}

.card-body {
  display: flex;
  padding: var(--space-m);
  gap: var(--space-m);
  align-items: flex-start;
  flex: 1;

  .char-portrait-container {
    position: relative;
    flex-shrink: 0;

    .char-portrait {
      width: 100px;
      height: 100px;
      border-radius: var(--radius-l);
      object-fit: cover;
      border: 2px solid var(--outline);
      box-shadow: var(--shadow-2);
    }

    .level-badge {
      position: absolute;
      bottom: -8px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--brand-blue);
      color: white;
      font-size: 10px;
      font-weight: 800;
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      border: 2px solid #1e1f22;
      white-space: nowrap;
    }
  }

  .char-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;

    .char-name {
      font-size: 20px;
      font-weight: 700;
      margin: 0;
      color: white;
      line-height: 1.2;
    }

    .char-sub-stats {
      font-size: 13px;
      color: var(--on-surface-muted);
      display: flex;
      align-items: center;
      gap: 6px;

      .separator {
        opacity: 0.5;
        font-size: 10px;
      }

      .ac-stat {
        background: rgba(255,255,255,0.05);
        padding: 1px 6px;
        border-radius: 4px;
        color: var(--brand-blue);
        font-weight: 600;
      }
    }

    .class-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;

      .class-chip {
        background: rgba(255, 255, 255, 0.08);
        color: var(--on-surface);
        font-size: 11px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: var(--radius-pill);
        border: 1px solid rgba(255,255,255,0.1);
      }
    }
  }
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background: rgba(0, 0, 0, 0.2);
  border-top: 1px solid var(--outline);

  .footer-actions-left {
    display: flex;
    gap: 2px;
  }

  .action-btn {
    width: 36px;
    height: 36px;
    line-height: 36px;
    color: var(--on-surface-muted);

    mat-icon {
      font-size: 18px;
      width: 18px;
      height: 18px;
    }

    &:hover {
      background: rgba(255,255,255,0.05);
      color: white;
    }

    &.btn-danger {
      color: var(--danger);
      &:hover {
        background: rgba(237, 66, 69, 0.1);
      }
    }
  }

  .btn-assign-servers {
    font-size: 12px;
    height: 32px;
    line-height: 32px;
    padding: 0 12px;
    background: rgba(255,255,255,0.05);
    color: var(--on-surface);
    border-radius: var(--radius-m);

    mat-icon {
      font-size: 16px;
      width: 16px;
      height: 16px;
      margin-right: 4px;
    }

    &:hover {
      background: var(--brand-blue-alpha);
      color: white;
    }
  }
}

/* --- Server Assign Menu --- */
::ng-deep .server-assign-menu {
  .mat-mdc-menu-panel {
    background: rgba(30, 31, 34, 0.9) !important;
    backdrop-filter: blur(20px) !important;
    border: 1px solid var(--outline) !important;
    border-radius: var(--radius-l) !important;
    padding: 8px 0 !important;
  }
  .menu-title {
    padding: 8px 16px; font-size: 11px; font-weight: 800; text-transform: uppercase;
    color: var(--on-surface-muted); letter-spacing: 1px;
  }
  button.mat-mdc-menu-item {
    color: var(--on-surface); font-size: 13px;
    &:hover { background: rgba(255,255,255,0.05); }
    mat-icon { margin-right: 12px; color: var(--brand-blue); }
  }
}

/* --- Empty State --- */
.empty-state-glass {
  grid-column: 1 / -1;
  background: rgba(255, 255, 255, 0.05);
  border: 2px dashed var(--outline);
  border-radius: var(--radius-xl);
  padding: var(--space-2xl);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-m);
  color: var(--on-surface-muted);

  mat-icon { font-size: 64px; width: 64px; height: 64px; color: var(--brand-blue-alpha); }
  h3 { font-size: 24px; font-weight: 700; margin: 0; color: white; }
  p { font-size: 16px; max-width: 400px; line-height: 1.5; }
  .btn-new-char {
    background: var(--brand-blue); color: white; font-weight: 700;
    padding: 0 var(--space-l); border-radius: var(--radius-l);
    &:hover { background: var(--brand-blue-hover); transform: translateY(-2px); box-shadow: 0 4px 15px rgba(114, 137, 218, 0.4); }
  }
}
</file>

<file path="src/app/pages/dashboard/call/spotify-player/spotify-player.html">
<div class="spotify-container" [class.tab-mode]="isTab">
  <div class="spotify-card">
    <!-- Header -->
    <div class="spotify-header">
      <div class="title-with-icon">
        <svg viewBox="0 0 24 24" width="22" height="22" class="spotify-icon"><path fill="currentColor" d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.306c-.216.354-.678.466-1.032.25-2.825-1.725-6.381-2.116-10.568-1.162-.405.093-.812-.162-.904-.567-.093-.406.162-.812.567-.904 4.583-1.047 8.51-.59 11.685 1.35.354.215.466.678.252 1.033zm1.472-3.26c-.272.443-.848.586-1.29.314-3.232-1.986-8.156-2.56-11.975-1.4-.5.15-1.026-.13-1.176-.63-.15-.5.13-1.027.63-1.177 4.365-1.325 9.807-.665 13.5 1.604.44.27.584.846.31 1.29zm.13-3.4c-3.877-2.302-10.283-2.513-14.004-1.383-.595.18-1.222-.164-1.402-.76-.18-.596.164-1.222.76-1.402 4.27-1.297 11.34-1.043 15.82 1.617.535.317.712 1 .395 1.535-.317.535-1 .712-1.535.395l-.035-.02z"/></svg>
        <h3 (click)="showProfile = false; groupedResults = {}" style="cursor: pointer">Spotify</h3>
      </div>
      <div class="header-actions">
        <!-- Pinned Pulldown Trigger -->
        <button *ngIf="!isTab" (click)="showPinnedPulldown = !showPinnedPulldown" class="header-btn" [class.active]="showPinnedPulldown" title="Pinned Items">
          <svg viewBox="0 0 24 24" width="18"><path fill="currentColor" d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22L12,23L12.8,16H18V14L16,12Z" /></svg>
        </button>

        <button *ngIf="!isTab" (click)="openAsTab()" class="header-btn" title="Open in Workspace">
          <svg viewBox="0 0 24 24" width="18"><path fill="currentColor" d="M10,21V19H3V5H10V3H3C1.9,3 1,3.9 1,5V19C1,20.1 1.9,21 3,21H10M11,7L9.6,8.4L12.2,11H5V13H12.2L9.6,15.6L11,17L16,12L11,7M18,3V21H20V3H18Z" /></svg>
        </button>
        <button (click)="showDevicePicker = !showDevicePicker" class="header-btn" [class.active]="showDevicePicker" title="Available Devices">
          <svg viewBox="0 0 24 24" width="18"><path fill="currentColor" d="M16 1h-8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2v-14c0-1.1-.9-2-2-2zm-4 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm4-7h-8v-7h8v7zm-9 10v2h10v-2h-10z"/></svg>
        </button>
        <button *ngIf="spotify.isAuthorized$ | async" (click)="spotify.logout()" class="header-btn logout-btn" title="Logout">
          <svg viewBox="0 0 24 24" width="16"><path fill="currentColor" d="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V6H14V4H5V20H14V18H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" /></svg>
        </button>
        <button *ngIf="!isTab" (click)="close.emit()" class="header-btn close-btn">&times;</button>
      </div>
    </div>

    <!-- Pinned Items Pulldown -->
    <div class="pinned-pulldown" [class.show]="showPinnedPulldown && !isTab">
      <div class="pulldown-content">
        <div class="pulldown-header">
          <span>Your Pinned</span>
          <button class="close-pulldown" (click)="showPinnedPulldown = false">&times;</button>
        </div>
        <div class="pulldown-list">
          <div *ngFor="let p of spotify.pinnedItems$ | async" class="pulldown-item" (click)="p.type === 'user' || p.type === 'artist' ? viewProfile(p.id,p.type) : playTrack({uri: p.uri})">
             <img [src]="p.image">
             <div class="item-info">
               <div class="name">{{p.name}}</div>
               <div class="owner">{{p.owner}} ({{p.type}})</div>
             </div>
          </div>
          <div *ngIf="!(spotify.pinnedItems$ | async)?.length" class="empty-pulldown">
            No pinned items.
          </div>
        </div>
      </div>
    </div>

    <!-- Device Picker Overlay -->
    <div class="device-picker-overlay" *ngIf="showDevicePicker" (click)="showDevicePicker = false">
      <div class="device-picker" (click)="$event.stopPropagation()">
        <h4>Select a device</h4>
        <div class="device-list">
          <div *ngFor="let device of spotify.devices$ | async" class="device-item" [class.active]="device.id === (spotify.activeDeviceId$ | async)" (click)="transferPlayback(device.id)">
            <div class="device-icon">
               <svg *ngIf="device.type === 'Computer'" viewBox="0 0 24 24" width="20"><path fill="currentColor" d="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/></svg>
               <svg *ngIf="device.type === 'Smartphone'" viewBox="0 0 24 24" width="20"><path fill="currentColor" d="M17 1H7c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-2-2-2zM7 4h10v14H7V4z"/></svg>
               <svg *ngIf="device.type !== 'Computer' && device.type !== 'Smartphone'" viewBox="0 0 24 24" width="20"><path fill="currentColor" d="M12 2c-4.97 0-9 4.03-9 9v7c0 1.1.9 2 2 2h3v-8H5v-1c0-3.87 3.13-7 7-7s7 3.13 7 7v1h-3v8h3c1.1 0 2-.9 2-2v-7c0-4.97-4.03-9-9-9z"/></svg>
            </div>
            <div class="device-info">
              <div class="device-name">{{device.name}}</div>
              <div class="device-status">{{device.is_active ? 'Currently Playing' : 'Spotify Connect'}}</div>
            </div>
          </div>
          <div *ngIf="!(spotify.devices$ | async)?.length" class="empty-hint">No active devices found. Open Spotify on any device.</div>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div *ngIf="spotify.isAuthorized$ | async" class="player-content">

      <!-- Sidebar (Library) - Visible in Tab mode -->
      <aside class="sidebar-nav" *ngIf="isTab">
        <div class="nav-tabs">
          <button (click)="activeSidebarTab = 'playlists'" [class.active]="activeSidebarTab === 'playlists'">Library</button>
          <button (click)="activeSidebarTab = 'recent'" [class.active]="activeSidebarTab === 'recent'">Recent</button>
          <button (click)="activeSidebarTab = 'pinned'" [class.active]="activeSidebarTab === 'pinned'">Pinned</button>
        </div>

        <div class="nav-content">
          <!-- Library Playlists -->
          <div *ngIf="activeSidebarTab === 'playlists'" class="list-container">
            <div *ngFor="let pl of spotify.savedPlaylists$ | async" class="nav-item">
              <img [src]="pl.images?.[0]?.url || 'assets/playlist-placeholder.png'" (click)="playTrack({uri: pl.uri, type: 'playlist'})">
              <div class="nav-info" (click)="playTrack({uri: pl.uri, type: 'playlist'})">
                <div class="nav-name">{{pl.name}}</div>
                <div class="nav-sub">Playlist</div>
              </div>
              <button class="pin-btn" (click)="spotify.togglePin(pl)" [class.pinned]="spotify.isPinned(pl.uri)">
                <svg viewBox="0 0 24 24" width="16"><path fill="currentColor" d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22L12,23L12.8,16H18V14L16,12Z" /></svg>
              </button>
            </div>
          </div>

          <!-- Recently Played -->
          <div *ngIf="activeSidebarTab === 'recent'" class="list-container">
            <div *ngFor="let item of spotify.recentPlays$ | async" class="nav-item" (click)="playTrack(item)">
              <img [src]="item.track?.album?.images?.[0]?.url || 'assets/spotify-placeholder.png'">
              <div class="nav-info">
                <div class="nav-name">{{item.track?.name}}</div>
                <div class="nav-sub">{{item.track?.artists?.[0]?.name}}</div>
              </div>
            </div>
          </div>

          <!-- Pinned Items -->
          <div *ngIf="activeSidebarTab === 'pinned'" class="list-container">
            <div *ngFor="let p of spotify.pinnedItems$ | async" class="nav-item">
              <img [src]="p.image" (click)="p.type === 'user' || p.type === 'artist' ? viewProfile(p.id,p.type) : playTrack({uri: p.uri})">
              <div class="nav-info" (click)="p.type === 'user' || p.type === 'artist' ? viewProfile(p.id,p.type) : playTrack({uri: p.uri})">
                <div class="nav-name">{{p.name}}</div>
                <div class="nav-sub">{{p.owner}}</div>
              </div>
              <button class="pin-btn pinned" (click)="spotify.togglePin(p)">
                <svg viewBox="0 0 24 24" width="16"><path fill="currentColor" d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22L12,23L12.8,16H18V14L16,12Z" /></svg>
              </button>
            </div>
            <div *ngIf="(spotify.pinnedItems$ | async)?.length === 0" class="empty-hint">
              Pin items to find them here easily.
            </div>
          </div>
        </div>
      </aside>

      <!-- Search & Results Workspace -->
      <div class="main-workspace">
        <div class="search-section">
          <div class="search-box">
            <input type="text" [(ngModel)]="spotifySearch" placeholder="Paste link or search..." (keyup.enter)="doSpotifySearch()">
            <button (click)="doSpotifySearch()" class="btn-search">Search</button>
          </div>

          <div class="workspace-tabs">
            <div class="search-categories" *ngIf="!showQueue && !showProfile">
              <button *ngFor="let cat of categories" [class.active]="activeCategory === cat.id" (click)="activeCategory = cat.id" class="cat-btn">{{cat.label}}</button>
            </div>
            <div class="profile-header-tab" *ngIf="showProfile && profileData">
                <button (click)="showProfile = false" class="back-btn"><svg viewBox="0 0 24 24" width="16"><path fill="currentColor" d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" /></svg></button>
                <img [src]="profileData.images?.[0]?.url || 'assets/spotify-placeholder.png'">
                <span>{{profileData.name || profileData.display_name}}</span>
                <button class="pin-profile-btn" (click)="spotify.togglePin({uri: profileData.uri, name: profileData.name || profileData.display_name, type: profileData.type, id: profileData.id, images: profileData.images})" [class.pinned]="spotify.isPinned(profileData.uri)">
                    <svg viewBox="0 0 24 24" width="16"><path fill="currentColor" d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22L12,23L12.8,16H18V14L16,12Z" /></svg>
                </button>
            </div>
            <button class="queue-toggle-btn" [class.active]="showQueue" (click)="showQueue = !showQueue">
              <svg viewBox="0 0 24 24" width="18"><path fill="currentColor" d="M15,15H17V11H15V15M11,15H13V11H11V15M7,15H9V11H7V15M3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3H5A2,2 0 0,0 3,5M5,5H19V19H5V5Z" /></svg>
              <span>Queue</span>
            </button>
          </div>

          <!-- Queue View -->
          <div class="queue-container" *ngIf="showQueue">
            <h4>Next Up</h4>
            <div class="results-list">
              <div *ngFor="let item of spotify.queue$ | async" class="queue-item">
                <img [src]="item.album?.images?.[0]?.url || 'assets/spotify-placeholder.png'" class="mini-thumb">
                <div class="track-info">
                  <div class="name">{{item.name}}</div>
                  <div class="artist" (click)="viewProfile(item.artists?.[0]?.id,'artist')">{{item.artists?.[0]?.name}}</div>
                </div>
              </div>
              <div *ngIf="!(spotify.queue$ | async)?.length" class="empty-hint">Your queue is empty.</div>
            </div>
          </div>

          <!-- Profile Content -->
          <div class="results" *ngIf="showProfile && !isLoading && !showQueue">
             <div *ngFor="let item of profileItems" class="result-item" (click)="playTrack(item)">
                <img [src]="item.image || 'assets/spotify-placeholder.png'" class="thumb">
                <div class="track-info">
                  <div class="name">{{item.name}}</div>
                  <div class="artist">{{item.artist || item.owner}}</div>
                </div>
                <div class="result-actions">
                  <div class="type-badge">{{item.type}}</div>
                  <button (click)="$event.stopPropagation(); spotify.togglePin(item)" [class.pinned]="spotify.isPinned(item.uri)">
                    <svg viewBox="0 0 24 24" width="14"><path fill="currentColor" d="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22L12,23L12.8,16H18V14L16,12Z" /></svg>
                  </button>
                </div>
             </div>
          </div>

          <!-- Search Results Grid -->
          <div class="results" *ngIf="filteredResults.length && !isLoading && !showQueue && !showProfile">
            <div *ngFor="let item of filteredResults" class="result-item" (click)="playTrack(item)">
              <img [src]="item.image || 'assets/spotify-placeholder.png'" class="thumb">
              <div class="track-info">
                <div class="name">{{item.name}}</div>
                <div class="artist">
                    <span *ngIf="item.artistId || item.ownerId" (click)="$event.stopPropagation(); viewProfile(item.artistId || item.ownerId, item.type === 'artist' ? 'artist' : (item.ownerId ? 'user' : 'artist'))">
                        {{item.artist || item.owner}}
                    </span>
