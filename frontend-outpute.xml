    MatFormFieldModule,
    MatInputModule,
    MatExpansionModule,
    MatTreeModule,
    MarkdownComponent,
    MatTooltipModule,
    MatMenuModule,
    MatSelectModule,
    MatDialogModule
  ],
  templateUrl: './obsidian-view.component.html',
  styleUrl: './obsidian-view.component.scss'
})
export class ObsidianViewComponent implements OnInit, OnDestroy {
  @ViewChild('markdownEditor') markdownEditor?: ElementRef<HTMLTextAreaElement>;
  @Input() serverId!: string;
  vaultName: string | null = null;
  localhostRoute: string | null = null;
  vaultEntries: VaultEntry[] = [];

  selectedFileContent: string = '';
  processedContent: string = '';

  selectedFileName: string = ''; // Full filename with extension
  selectedFileDisplayName: string = ''; // Name without extension for editing
  selectedFileRelativePath: string = '';
  isEditing: boolean = false;
  isPreview: boolean = true;
  permissionGranted: boolean = false;
  fileSystemApiSupported: boolean = false;

  // For non-markdown files
  nonMarkdownUrl: SafeUrl | null = null;
  isImage: boolean = false;
  isPdf: boolean = false;

  // Context Menu Support
  contextMenuPosition = { x: '0px', y: '0px' };

  readonly editorActions = [
    { icon: 'title', label: 'Heading', action: 'heading', tooltip: 'Add a section title' },
    { icon: 'format_bold', label: 'Bold', action: 'bold', tooltip: 'Make selected text bold' },
    { icon: 'format_italic', label: 'Italic', action: 'italic', tooltip: 'Emphasize selected text' },
    { icon: 'format_list_bulleted', label: 'Bullets', action: 'bullet', tooltip: 'Turn lines into a bullet list' },
    { icon: 'check_box', label: 'Checklist', action: 'checklist', tooltip: 'Create a task list' },
    { icon: 'link', label: 'Link', action: 'link', tooltip: 'Insert a web link' },
    { icon: 'format_quote', label: 'Quote', action: 'quote', tooltip: 'Highlight quoted text' },
    { icon: 'code', label: 'Code', action: 'code', tooltip: 'Format code or fixed-width text' }
  ] as const;

  readonly markdownTips = [
    {
      title: 'Start with plain text',
      description: 'Type naturally. Use the buttons above when you want structure instead of memorizing symbols.'
    },
    {
      title: 'Preview before sharing',
      description: 'Switch to Preview to check headings, lists, links, and embeds exactly as readers will see them.'
    },
    {
      title: 'Your work saves automatically',
      description: 'Changes are stored a moment after you stop typing, so you do not need a separate save button.'
    }
  ] as const;

  readonly noteTemplates = [
    'Historical Event.md',
    'Item.md',
    'Location.md',
    'Lore & Mythology.md',
    'Magical Artefact or System.md',
    'NPC.md',
    'Organisation.md',
    'Player Character.md',
    'Race.md',
    'Story Arc.md',
    'Story Event.md',
    '🎲 Session {{number}} - {{date}}.md'
  ] as const;

  resourcePickerOpen = false;
  resourceSearch = '';
  resourceFiles: VaultEntry[] = [];
  createEntryMode: 'file' | 'folder' = 'file';
  newEntryName = '';
  selectedTemplateName = '';
  expandedFolderPaths = new Set<string>();
  draggedEntryPath: string | null = null;
  currentDropTargetPath: string | null = null;
  dropTargetIsRoot = false;
  hasBroadcastSelection = false;
  private editorSelectionStart = 0;
  private editorSelectionEnd = 0;
  private editorScrollTop = 0;
  private objectUrls: string[] = [];
  private contentChanged = new Subject<void>();
  private autoSaveSubscription?: Subscription;
  private boundSelectionChange = () => this.updateBroadcastSelectionState();

  constructor(
    private obsidianVaultService: ObsidianVaultService,
    private route: ActivatedRoute,
    private sanitizer: DomSanitizer,
    private dialog: MatDialog
  ) {}

  ngOnInit(): void {
    this.fileSystemApiSupported = this.obsidianVaultService.isFileSystemApiSupported();

    if (!this.serverId) {
      this.route.paramMap.subscribe(params => {
        const id = params.get('serverId');
        if (id) {
          this.serverId = id;
          this.loadVaultInfo();
        }
      });
    } else {
      this.loadVaultInfo();
    }

    // Set up auto-save
    this.autoSaveSubscription = this.contentChanged.pipe(
      debounceTime(1000) // Auto-save after 1 second of inactivity
    ).subscribe(() => {
      this.saveFile();
    });

    document.addEventListener('selectionchange', this.boundSelectionChange);
  }

  ngOnDestroy(): void {
    this.revokeObjectUrls();
    this.autoSaveSubscription?.unsubscribe();
    document.removeEventListener('selectionchange', this.boundSelectionChange);
  }

  async loadVaultInfo(): Promise<void> {
    if (this.serverId) {
      this.localhostRoute = this.obsidianVaultService.getVaultLocalhostRoute(this.serverId);

      const handle = await this.obsidianVaultService.getVaultHandle(this.serverId);
      if (handle) {
        this.vaultName = handle.name;
        const options = { mode: 'readwrite' };
        if ((await (handle as any).queryPermission(options)) === 'granted') {
          this.permissionGranted = true;
          this.loadVaultEntries();
        }
      }
    }
  }

  async attachVault(): Promise<void> {
    if (!this.fileSystemApiSupported) return;

    if (this.serverId) {
      try {
        this.vaultName = await this.obsidianVaultService.attachVaultToServer(this.serverId);
        this.permissionGranted = true;
        await this.loadVaultEntries();
      } catch (err) {
        console.error('Failed to attach vault:', err);
      }
    }
  }

  async requestPermission(): Promise<void> {
    const handle = await this.obsidianVaultService.getVaultHandle(this.serverId);
    if (handle) {
      this.permissionGranted = await this.obsidianVaultService.requestPermission(handle);
      if (this.permissionGranted) {
        this.loadVaultEntries();
      }
    }
  }

  async loadVaultEntries(): Promise<void> {
    this.vaultEntries = await this.obsidianVaultService.listVaultFiles(this.serverId);
    this.resourceFiles = this.flattenResourceFiles(this.vaultEntries);
    this.syncExpandedFolders();
    console.log('Vault entries loaded:', this.vaultEntries);
  }

  async selectFile(entry: VaultEntry): Promise<void> {
    if (entry.kind === 'directory') return;

    this.revokeObjectUrls();
    this.closeResourcePicker();
    this.hasBroadcastSelection = false;
    this.selectedFileName = entry.name;
    this.selectedFileDisplayName = this.getDisplayName(entry.name);
    this.selectedFileRelativePath = entry.relativePath;
    this.isEditing = true;

    if (entry.name.toLowerCase().endsWith('.md')) {
      this.isImage = false;
      this.isPdf = false;
      this.nonMarkdownUrl = null;
      this.selectedFileContent = await this.obsidianVaultService.readFile(this.serverId, entry.relativePath);
      this.isPreview = true;
      await this.processContent();
    } else {
      const blob = await this.obsidianVaultService.readFileAsBlob(this.serverId, entry.relativePath);
      const url = URL.createObjectURL(blob);
      this.objectUrls.push(url);
      this.nonMarkdownUrl = this.sanitizer.bypassSecurityTrustResourceUrl(url);
      this.isImage = this.isImageFile(entry.name);
      this.isPdf = this.isPdfFile(entry.name);
      this.isPreview = true;
      this.selectedFileContent = '';
    }
  }

  openCreatePopover(mode: 'file' | 'folder', trigger: MatMenuTrigger): void {
    this.createEntryMode = mode;
    this.newEntryName = '';
    this.selectedTemplateName = '';
    trigger.openMenu();
  }

  closeCreatePopover(trigger: MatMenuTrigger): void {
    trigger.closeMenu();
    this.newEntryName = '';
    this.selectedTemplateName = '';
  }

  async submitCreateEntry(trigger: MatMenuTrigger): Promise<void> {
    const trimmedName = this.newEntryName.trim().replace(/^\/+|\/+$/g, '');
    if (!trimmedName) {
      return;
    }

    try {
      if (this.createEntryMode === 'folder') {
        await this.obsidianVaultService.createFolder(this.serverId, trimmedName);
        await this.loadVaultEntries();
        this.expandAncestorFolders(trimmedName);
        this.expandedFolderPaths.add(trimmedName);
        this.closeCreatePopover(trigger);
        return;
      }

      const fullFileName = trimmedName.endsWith('.md') ? trimmedName : `${trimmedName}.md`;
      const templateContent = this.selectedTemplateName
        ? await this.loadTemplateContent(this.selectedTemplateName)
        : '';
      await this.obsidianVaultService.writeFile(this.serverId, fullFileName, templateContent);
      await this.loadVaultEntries();

      const newEntry = this.findEntryByPath(fullFileName, this.vaultEntries);
      if (newEntry) {
        await this.selectFile(newEntry);
        this.isPreview = false;
      }

      this.closeCreatePopover(trigger);
    } catch (err) {
      console.error(`Failed to create ${this.createEntryMode}:`, err);
    }
  }

  async renameSelectedFile(): Promise<void> {
    const currentDisplayName = this.getDisplayName(this.selectedFileName);
    const newDisplayName = this.selectedFileDisplayName;

    if (!newDisplayName || newDisplayName === currentDisplayName) {
      this.selectedFileDisplayName = currentDisplayName;
      return;
    }

    const extension = this.selectedFileName.includes('.') ? this.selectedFileName.split('.').pop() : 'md';
    const fullNewName = newDisplayName.endsWith(`.${extension}`) ? newDisplayName : `${newDisplayName}.${extension}`;

    try {
      const newPath = await this.obsidianVaultService.renameFile(this.serverId, this.selectedFileRelativePath, fullNewName);
      this.selectedFileName = fullNewName;
      this.selectedFileDisplayName = newDisplayName;
      this.selectedFileRelativePath = newPath;
      await this.loadVaultEntries();
    } catch (err) {
      console.error('Failed to rename file:', err);
      this.selectedFileDisplayName = currentDisplayName;
    }
  }

  getDisplayName(name: string): string {
    return name.endsWith('.md') ? name.slice(0, -3) : name;
  }

  getEntryLabel(entry: VaultEntry): string {
    return entry.kind === 'file' ? this.getDisplayName(entry.name) : entry.name;
  }

  isFolderExpanded(path: string): boolean {
    return this.expandedFolderPaths.has(path);
  }

  onFolderExpanded(path: string): void {
    this.expandedFolderPaths.add(path);
  }

  onFolderCollapsed(path: string): void {
    this.expandedFolderPaths.delete(path);
  }

  onContentChange(): void {
    this.contentChanged.next();
    this.updateBroadcastSelectionState();
  }

  onDragStart(event: DragEvent, entry: VaultEntry): void {
    if (event.dataTransfer) {
      event.dataTransfer.setData('application/json', JSON.stringify({
        relativePath: entry.relativePath,
        kind: entry.kind
      }));
      event.dataTransfer.setData('text/plain', entry.relativePath);
      event.dataTransfer.effectAllowed = 'move';
    }

    this.draggedEntryPath = entry.relativePath;
    this.currentDropTargetPath = null;
    this.dropTargetIsRoot = false;
  }

  onDragEnd(): void {
    this.clearDragState();
  }

  onDragOver(event: DragEvent, targetEntry?: VaultEntry): void {
    event.preventDefault();
    if (event.dataTransfer) {
      event.dataTransfer.dropEffect = 'move';
    }

    const sourcePath = this.getDraggedPath(event);
    if (!sourcePath) return;

    const targetPath = targetEntry?.kind === 'directory' ? targetEntry.relativePath : '';
    if (!this.canDropEntry(sourcePath, targetPath)) {
      this.currentDropTargetPath = null;
      this.dropTargetIsRoot = false;
      return;
    }

    this.currentDropTargetPath = targetPath || null;
    this.dropTargetIsRoot = !targetPath;
  }

  onRootDragOver(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
    this.onDragOver(event);
  }

  onRootDragLeave(event: DragEvent): void {
    event.preventDefault();
    event.stopPropagation();
    this.dropTargetIsRoot = false;
  }

  async onDrop(event: DragEvent, targetEntry?: VaultEntry): Promise<void> {
    event.preventDefault();
    const sourcePath = this.getDraggedPath(event);
    if (!sourcePath) {
      this.clearDragState();
      return;
    }

    const targetDirPath = (targetEntry && targetEntry.kind === 'directory') ? targetEntry.relativePath : '';

    if (!this.canDropEntry(sourcePath, targetDirPath)) {
      this.clearDragState();
      return;
    }

    try {
      const movedPath = await this.obsidianVaultService.moveEntry(this.serverId, sourcePath, targetDirPath);
      this.updateExpandedPathsAfterMove(sourcePath, movedPath);
      await this.loadVaultEntries();
      this.updateSelectedPathAfterMove(sourcePath, movedPath);
    } catch (err) {
      console.error('Failed to move entry:', err);
    } finally {
      this.clearDragState();
    }
  }

  async onRootDrop(event: DragEvent): Promise<void> {
    event.preventDefault();
    event.stopPropagation();
    await this.onDrop(event);
  }

  async deleteEntry(entry: VaultEntry, event?: Event): Promise<void> {
    if (event) event.stopPropagation();

    if (confirm(`Are you sure you want to delete ${entry.name}?`)) {
      try {
        await this.obsidianVaultService.deleteEntry(this.serverId, entry.relativePath);
        if (this.selectedFileRelativePath === entry.relativePath) {
          this.cancelEdit();
        }
        await this.loadVaultEntries();
      } catch (err) {
        console.error('Failed to delete entry:', err);
      }
    }
  }

  onContextMenu(event: MouseEvent, trigger: MatMenuTrigger): void {
    event.preventDefault();
    event.stopPropagation();
    this.contextMenuPosition.x = event.clientX + 'px';
    this.contextMenuPosition.y = event.clientY + 'px';
    trigger.openMenu();
  }

  private findEntryByPath(path: string, entries: VaultEntry[]): VaultEntry | null {
    const lowerPath = path.toLowerCase();
    for (const entry of entries) {
      if (entry.relativePath.toLowerCase() === lowerPath) return entry;
      if (entry.children) {
        const found = this.findEntryByPath(path, entry.children);
        if (found) return found;
      }
    }
    return null;
  }

  async saveFile(): Promise<void> {
    if (this.selectedFileRelativePath && this.selectedFileName.endsWith('.md')) {
      try {
        await this.obsidianVaultService.writeFile(
          this.serverId,
          this.selectedFileRelativePath,
          this.selectedFileContent
        );
      } catch (err) {
        console.error('Failed to auto-save file:', err);
      }
    }
  }

  async toggleEditMode(): Promise<void> {
    if (!this.selectedFileName.endsWith('.md')) return; // Non-editable

    this.isPreview = !this.isPreview;
    if (this.isPreview) {
      await this.processContent();
    }
  }

  async setMarkdownView(preview: boolean): Promise<void> {
    if (!this.selectedFileName.endsWith('.md') || this.isPreview === preview) {
      return;
    }

    this.isPreview = preview;
    if (this.isPreview) {
      await this.processContent();
      return;
    }

    setTimeout(() => this.markdownEditor?.nativeElement.focus());
  }

  onEditorActionMouseDown(event: MouseEvent): void {
    event.preventDefault();
    this.captureEditorState();
  }

  openResourcePicker(): void {
    this.captureEditorState();
    this.resourceSearch = '';
    this.resourcePickerOpen = true;
  }

  closeResourcePicker(): void {
    this.resourcePickerOpen = false;
    this.resourceSearch = '';
  }

  get filteredResourceFiles(): VaultEntry[] {
    const query = this.resourceSearch.trim().toLowerCase();
    if (!query) {
      return this.resourceFiles;
    }

    return this.resourceFiles.filter(entry =>
      entry.name.toLowerCase().includes(query) ||
      entry.relativePath.toLowerCase().includes(query)
    );
  }

  insertResourceEmbed(entry: VaultEntry): void {
    const editor = this.markdownEditor?.nativeElement;
    if (!editor) return;

    this.captureEditorState();

    const lineStart = this.selectedFileContent.lastIndexOf('\n', Math.max(this.editorSelectionStart - 1, 0)) + 1;
    const nextNewLineIndex = this.selectedFileContent.indexOf('\n', this.editorSelectionEnd);
    const lineEnd = nextNewLineIndex === -1 ? this.selectedFileContent.length : nextNewLineIndex;
    const currentLine = this.selectedFileContent.slice(lineStart, lineEnd);
    const embedMarkup = `![[${entry.relativePath}]]`;

    let replacement = currentLine;
    let selectionStart = lineStart;
    let selectionEnd = lineStart + embedMarkup.length;

    if (currentLine.trim().length === 0) {
      replacement = embedMarkup;
    } else if (currentLine.includes(embedMarkup)) {
      replacement = currentLine;
      const embedIndex = currentLine.indexOf(embedMarkup);
      selectionStart = lineStart + embedIndex;
      selectionEnd = selectionStart + embedMarkup.length;
    } else {
      replacement = `${currentLine}\n${embedMarkup}`;
      selectionStart = lineStart + currentLine.length + 1;
      selectionEnd = selectionStart + embedMarkup.length;
    }

    this.selectedFileContent =
      this.selectedFileContent.slice(0, lineStart) +
      replacement +
      this.selectedFileContent.slice(lineEnd);

    this.onContentChange();
    this.closeResourcePicker();

    setTimeout(() => {
      editor.focus({ preventScroll: true });
      editor.setSelectionRange(selectionStart, selectionEnd);
      editor.scrollTop = this.editorScrollTop;
      this.editorSelectionStart = selectionStart;
      this.editorSelectionEnd = selectionEnd;
    });
  }

  applyEditorAction(action: typeof this.editorActions[number]['action']): void {
    const editor = this.markdownEditor?.nativeElement;
    if (!editor) return;

    this.captureEditorState();

    const start = this.editorSelectionStart;
    const end = this.editorSelectionEnd;
    const selectedText = this.selectedFileContent.slice(start, end);

    let replaceStart = start;
    let replaceEnd = end;
    let replacement = selectedText;
    let selectionStart = start;
    let selectionEnd = end;

    switch (action) {
      case 'heading': {
        ({ replacement, selectionStart, selectionEnd } = this.toggleLinePrefix(start, selectedText, '# ', 'New section'));
        break;
      }
      case 'bold': {
        ({ replaceStart, replaceEnd, replacement, selectionStart, selectionEnd } = this.toggleWrapSelection(start, end, '**', '**', 'Important'));
        break;
      }
      case 'italic': {
        ({ replaceStart, replaceEnd, replacement, selectionStart, selectionEnd } = this.toggleWrapSelection(start, end, '*', '*', 'Emphasis'));
        break;
      }
      case 'bullet': {
        ({ replacement, selectionStart, selectionEnd } = this.toggleLinePrefix(start, selectedText, '- ', 'List item'));
        break;
      }
      case 'checklist': {
        ({ replacement, selectionStart, selectionEnd } = this.toggleLinePrefix(start, selectedText, '- [ ] ', 'Task'));
        break;
      }
      case 'link': {
        ({ replacement, selectionStart, selectionEnd } = this.toggleLinkSelection(start, end, 'Link text'));
        break;
      }
      case 'quote': {
        ({ replacement, selectionStart, selectionEnd } = this.toggleLinePrefix(start, selectedText, '> ', 'Quoted text'));
        break;
      }
      case 'code': {
        ({ replaceStart, replaceEnd, replacement, selectionStart, selectionEnd } = this.toggleCodeSelection(start, end, selectedText));
        break;
      }
    }

    this.selectedFileContent =
      this.selectedFileContent.slice(0, replaceStart) +
      replacement +
      this.selectedFileContent.slice(replaceEnd);

    this.onContentChange();

    setTimeout(() => {
      editor.focus({ preventScroll: true });
      editor.setSelectionRange(selectionStart, selectionEnd);
      editor.scrollTop = this.editorScrollTop;
      this.editorSelectionStart = selectionStart;
      this.editorSelectionEnd = selectionEnd;
    });
  }

  trackEditorSelection(): void {
    this.captureEditorState();
    this.updateBroadcastSelectionState();
  }

  private captureEditorState(): void {
    const editor = this.markdownEditor?.nativeElement;
    if (!editor) return;

    this.editorSelectionStart = editor.selectionStart ?? 0;
    this.editorSelectionEnd = editor.selectionEnd ?? 0;
    this.editorScrollTop = editor.scrollTop;
  }

  private getDraggedPath(event: DragEvent): string | null {
    const serialized = event.dataTransfer?.getData('application/json');
    if (serialized) {
      try {
        const data = JSON.parse(serialized) as { relativePath?: string };
        if (data.relativePath) {
          return data.relativePath;
        }
      } catch {
        // Fall back to plain text below.
      }
    }

    return event.dataTransfer?.getData('text/plain') || this.draggedEntryPath;
  }

  private canDropEntry(sourcePath: string, targetPath: string): boolean {
    const normalizedSource = sourcePath.trim().replace(/^\/+|\/+$/g, '');
    const normalizedTarget = targetPath.trim().replace(/^\/+|\/+$/g, '');

    if (!normalizedSource) return false;
    if (normalizedSource === normalizedTarget) return false;
    if (normalizedTarget && normalizedSource.startsWith(`${normalizedTarget}/`)) return false;

    const sourceParentPath = normalizedSource.includes('/')
      ? normalizedSource.slice(0, normalizedSource.lastIndexOf('/'))
      : '';

    return sourceParentPath !== normalizedTarget;
  }

  private updateSelectedPathAfterMove(sourcePath: string, movedPath: string): void {
    if (this.selectedFileRelativePath === sourcePath) {
      this.selectedFileRelativePath = movedPath;
      return;
    }

    if (this.selectedFileRelativePath.startsWith(`${sourcePath}/`)) {
      this.selectedFileRelativePath = this.selectedFileRelativePath.replace(sourcePath, movedPath);
    }
  }

  private updateExpandedPathsAfterMove(sourcePath: string, movedPath: string): void {
    this.expandedFolderPaths = new Set(
      Array.from(this.expandedFolderPaths, path => {
        if (path === sourcePath) {
          return movedPath;
        }

        if (path.startsWith(`${sourcePath}/`)) {
          return path.replace(sourcePath, movedPath);
        }

        return path;
      })
    );
  }

  private syncExpandedFolders(): void {
    const validPaths = new Set<string>();
    this.collectDirectoryPaths(this.vaultEntries, validPaths);

    this.expandedFolderPaths = new Set(
      Array.from(this.expandedFolderPaths).filter(path => validPaths.has(path))
    );

    if (this.selectedFileRelativePath) {
      this.expandAncestorFolders(this.selectedFileRelativePath);
    }
  }

  private collectDirectoryPaths(entries: VaultEntry[], paths: Set<string>): void {
    for (const entry of entries) {
      if (entry.kind !== 'directory') {
        continue;
      }

      paths.add(entry.relativePath);
      if (entry.children?.length) {
        this.collectDirectoryPaths(entry.children, paths);
      }
    }
  }

  private expandAncestorFolders(path: string): void {
    const parts = path.split('/').filter(Boolean);
    if (parts.length <= 1) {
      return;
    }

    let currentPath = '';
    for (const part of parts.slice(0, -1)) {
      currentPath = currentPath ? `${currentPath}/${part}` : part;
      this.expandedFolderPaths.add(currentPath);
    }
  }

  private clearDragState(): void {
    this.draggedEntryPath = null;
    this.currentDropTargetPath = null;
    this.dropTargetIsRoot = false;
  }

  private flattenResourceFiles(entries: VaultEntry[]): VaultEntry[] {
    const files: VaultEntry[] = [];

    for (const entry of entries) {
      if (entry.kind === 'file' && !entry.name.toLowerCase().endsWith('.md')) {
        files.push(entry);
      }

      if (entry.children?.length) {
        files.push(...this.flattenResourceFiles(entry.children));
      }
    }

    return files.sort((a, b) => a.relativePath.localeCompare(b.relativePath));
  }

  private async loadTemplateContent(templateName: string): Promise<string> {
    const templateUrl = this.buildTemplateAssetUrl(templateName);
    const response = await fetch(templateUrl);

    if (!response.ok) {
      throw new Error(`Failed to load template: ${templateName}`);
    }

    return await response.text();
  }

  private buildTemplateAssetUrl(templateName: string): string {
    const encodedPath = templateName
      .split('/')
      .map(segment => encodeURIComponent(segment))
      .join('/');

    return `assets/templates/${encodedPath}`;
  }

  private toggleWrapSelection(
    start: number,
    end: number,
    prefix: string,
    suffix: string,
    fallback: string
  ): { replaceStart: number; replaceEnd: number; replacement: string; selectionStart: number; selectionEnd: number } {
    const hasWrappedSelection =
      start >= prefix.length &&
      this.selectedFileContent.slice(start - prefix.length, start) === prefix &&
      this.selectedFileContent.slice(end, end + suffix.length) === suffix;

    if (hasWrappedSelection) {
      const replacement = this.selectedFileContent.slice(start, end);
      const replaceStart = start - prefix.length;
      const replaceEnd = end + suffix.length;
      const selectionStart = replaceStart;
      const selectionEnd = selectionStart + replacement.length;
      return { replaceStart, replaceEnd, replacement, selectionStart, selectionEnd };
    }

    const selectedText = this.selectedFileContent.slice(start, end);
    const content = selectedText || fallback;
    const replacement = `${prefix}${content}${suffix}`;
    const selectionStart = start + prefix.length;
    const selectionEnd = selectionStart + content.length;
    return { replaceStart: start, replaceEnd: end, replacement, selectionStart, selectionEnd };
  }

  private toggleLinePrefix(
    start: number,
    selectedText: string,
    prefix: string,
    fallback: string
  ): { replacement: string; selectionStart: number; selectionEnd: number } {
    const content = selectedText || fallback;
    const lines = content.split('\n');
    const allPrefixed = lines.every(line => line.startsWith(prefix));
    const replacement = lines
      .map(line => allPrefixed ? line.slice(prefix.length) : `${prefix}${line || ''}`.trimEnd())
      .join('\n');
    const selectionStart = start;
    const selectionEnd = start + replacement.length;
    return { replacement, selectionStart, selectionEnd };
  }

  private toggleLinkSelection(
    start: number,
    end: number,
    fallback: string
  ): { replacement: string; selectionStart: number; selectionEnd: number } {
    const selectedText = this.selectedFileContent.slice(start, end);
    const fullSelection = this.selectedFileContent.slice(start, end);
    const linkMatch = fullSelection.match(/^\[([^\]]+)\]\(([^)]+)\)$/);

    if (linkMatch) {
      const replacement = linkMatch[1];
      return {
        replacement,
        selectionStart: start,
        selectionEnd: start + replacement.length
      };
    }

    const linkText = selectedText || fallback;
    const replacement = `[${linkText}](https://example.com)`;
    return {
      replacement,
      selectionStart: start + linkText.length + 3,
      selectionEnd: start + replacement.length - 1
    };
  }

  private toggleCodeSelection(
    start: number,
    end: number,
    selectedText: string
  ): { replaceStart: number; replaceEnd: number; replacement: string; selectionStart: number; selectionEnd: number } {
    if (selectedText.includes('\n')) {
      const fencedSelection = this.selectedFileContent.slice(start, end);
      const fencedMatch = fencedSelection.match(/^```[\r\n]+([\s\S]*?)[\r\n]+```$/);

      if (fencedMatch) {
        const replacement = fencedMatch[1];
        return {
          replaceStart: start,
          replaceEnd: end,
          replacement,
          selectionStart: start,
          selectionEnd: start + replacement.length
        };
      }

      const replacement = `\`\`\`\n${selectedText || 'code'}\n\`\`\``;
      return {
        replaceStart: start,
        replaceEnd: end,
        replacement,
        selectionStart: start + 4,
        selectionEnd: start + replacement.length - 4
      };
    }

    return this.toggleWrapSelection(start, end, '`', '`', 'code');
  }

  private async processContent(): Promise<void> {
    console.log('processContent: Starting...');
    this.revokeObjectUrls();
    this.processedContent = await this.renderMarkdownWithEmbeds(
      this.selectedFileContent,
      this.selectedFileRelativePath,
      new Set([this.selectedFileRelativePath.toLowerCase()])
    );
    console.log('processContent: Finished. Processed content updated.');
  }

  private async renderMarkdownWithEmbeds(
    content: string,
    currentFilePath: string,
    visitedPaths: Set<string>
  ): Promise<string> {
    const embedRegex = /!\[\[(.*?)\]\]/g;
    let rebuiltContent = '';
    let lastIndex = 0;

    for (const match of content.matchAll(embedRegex)) {
      const fullMatch = match[0];
      const linkContent = match[1].trim();
      const startIndex = match.index ?? 0;

      rebuiltContent += content.slice(lastIndex, startIndex);
      rebuiltContent += await this.renderObsidianEmbed(linkContent, currentFilePath, visitedPaths);
      lastIndex = startIndex + fullMatch.length;
    }

    rebuiltContent += content.slice(lastIndex);
    return this.rewriteInternalLinks(rebuiltContent);
  }

  private async renderObsidianEmbed(
    linkContent: string,
    currentFilePath: string,
    visitedPaths: Set<string>
  ): Promise<string> {
    const parts = linkContent.split('|');
    const filePath = parts[0].trim();
    const width = parts[1] ? parts[1].trim() : '';
    const resolvedPath = await this.resolveEmbedPath(filePath, currentFilePath);

    console.log(`renderObsidianEmbed: "${linkContent}" resolved to "${resolvedPath}" from "${currentFilePath}"`);

    if (!resolvedPath) {
      console.warn(`renderObsidianEmbed: No resolved path found for "${linkContent}"`);
      return `![[${linkContent}]]`;
    }

    if (resolvedPath.toLowerCase().endsWith('.md')) {
      const visitedKey = resolvedPath.toLowerCase();
      if (visitedPaths.has(visitedKey)) {
        return `<div class="embedded-note embedded-note-loop">Embedded note skipped to avoid a recursion loop: ${this.escapeHtml(filePath)}</div>`;
      }

      try {
        const embeddedContent = await this.obsidianVaultService.readFile(this.serverId, resolvedPath);
        const nestedVisitedPaths = new Set(visitedPaths);
        nestedVisitedPaths.add(visitedKey);
        const renderedContent = await this.renderMarkdownWithEmbeds(embeddedContent, resolvedPath, nestedVisitedPaths);
        const embeddedTitle = this.escapeHtml(this.getDisplayName(resolvedPath.split('/').pop() || filePath));
        return `<section class="embedded-note"><div class="embedded-note-title">${embeddedTitle}</div>${renderedContent}</section>`;
      } catch (error) {
        console.warn('renderObsidianEmbed: Could not load embedded markdown note:', resolvedPath, error);
        return `<div class="embedded-note embedded-note-error">Unable to load embedded note: ${this.escapeHtml(filePath)}</div>`;
      }
    }

    try {
      const blob = await this.obsidianVaultService.readFileAsBlob(this.serverId, resolvedPath);
      const url = URL.createObjectURL(blob);
      this.objectUrls.push(url);

      const style = width ? `width: ${width}px; max-width: 100%;` : `max-width: 100%;`;

      if (this.isImageFile(resolvedPath)) {
        return `<img src="${url}" alt="${this.escapeHtml(filePath)}" style="${style} border-radius: 4px;">`;
      }

      if (this.isPdfFile(resolvedPath)) {
        return `<embed src="${url}" type="application/pdf" width="100%" height="600px">`;
      }

      return `<a href="${url}" target="_blank">Download ${this.escapeHtml(filePath)}</a>`;
    } catch (error) {
      console.warn('renderObsidianEmbed: Could not load embedded file:', resolvedPath, error);
      return `![[${linkContent}]]`;
    }
  }

  private rewriteInternalLinks(content: string): string {
    const linkRegex = /\[\[(.*?)\]\]/g;
    return content.replace(linkRegex, (_match, p1) => {
      const parts = p1.split('|');
      const targetPath = parts[0].trim();
      const displayName = parts[1] ? parts[1].trim() : targetPath;
      return `<a class="internal-link" data-path="${targetPath}" title="${targetPath}" style="color: #00a8fc; cursor: pointer;">${this.escapeHtml(displayName)}</a>`;
    });
  }

  private escapeHtml(value: string): string {
    return value
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  isImageFile(path: string): boolean {
    const ext = path.split('.').pop()?.toLowerCase();
    return ['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg'].includes(ext || '');
  }

  isPdfFile(path: string): boolean {
    return path.toLowerCase().endsWith('.pdf');
  }

  private revokeObjectUrls(): void {
    this.objectUrls.forEach(url => URL.revokeObjectURL(url));
    this.objectUrls = [];
  }

  handleMarkdownClick(event: MouseEvent): void {
    const target = event.target as HTMLElement;
    const link = target.closest('.internal-link');

    if (link) {
      console.log('handleMarkdownClick: INTERNAL LINK CLICKED');
      // Try multiple attributes in case sanitizer strips data-path
      let path = link.getAttribute('data-path') || link.getAttribute('title');

      // If attributes are stripped, fallback to text content (only if no alias was used)
      if (!path) {
        path = link.textContent?.trim() || null;
        console.log('handleMarkdownClick: Fallback to text content:', path);
      }

      console.log('handleMarkdownClick: Path extracted:', path);
      if (path) {
        event.preventDefault();
        event.stopPropagation();
        this.openInternalLink(path);
      }
    }
  }

  handleMarkdownContextMenu(event: MouseEvent): void {
    const target = event.target as HTMLElement;
    const image = target.closest('img');

    if (!image) {
      return;
    }

    event.preventDefault();
    event.stopPropagation();
    this.broadcastImageElement(image as HTMLImageElement);
  }

  handleImageContextMenu(event: MouseEvent): void {
    const target = event.target as HTMLElement;
    const image = target.closest('img');

    if (!image) {
      return;
    }

    event.preventDefault();
    event.stopPropagation();
    this.broadcastImageElement(image as HTMLImageElement);
  }

  private async openInternalLink(linkPath: string): Promise<void> {
    // Clean up input: trim and remove invisible characters (like zero-width spaces)
    linkPath = linkPath.trim().replace(/[\u200B-\u200D\uFEFF]/g, '');
    console.log(`openInternalLink: Triggered for path "${linkPath}"`);

    const currentFileDir = this.selectedFileRelativePath.split('/').slice(0, -1).join('/');

    // 1. Try exact match from root or with .md
    let entry = this.findEntryByPath(linkPath, this.vaultEntries);
    if (!entry && !linkPath.toLowerCase().endsWith('.md')) {
      entry = this.findEntryByPath(`${linkPath}.md`, this.vaultEntries);
    }

    // 2. Try relative to current file
    if (!entry) {
      const relativePath = this.obsidianVaultService.resolveRelativePath(currentFileDir, linkPath);
      entry = this.findEntryByPath(relativePath, this.vaultEntries);
      if (!entry && !relativePath.toLowerCase().endsWith('.md')) {
        entry = this.findEntryByPath(`${relativePath}.md`, this.vaultEntries);
      }
    }

    // 3. Global search by filename (anywhere in the vault) - this satisfies "find filename.md in any folder"
    if (!entry) {
      const fileName = linkPath.split('/').pop()!;
      entry = this.findEntryByName(fileName, this.vaultEntries);

      if (!entry && !fileName.toLowerCase().endsWith('.md')) {
        const fileNameWithMd = `${fileName}.md`;
        entry = this.findEntryByName(fileNameWithMd, this.vaultEntries);
      }
    }

    // 4. Try global search by base name (ignore extension)
    if (!entry) {
      const fileName = linkPath.split('/').pop()!;
      const baseName = fileName.includes('.') ? fileName.substring(0, fileName.lastIndexOf('.')) : fileName;
      entry = this.findEntryByBaseName(baseName, this.vaultEntries);
    }

    if (entry) {
      console.log(`openInternalLink: Found matching entry at "${entry.relativePath}"`);
      await this.selectFile(entry);
    } else {
      console.warn(`Internal link target not found: ${linkPath}`);
    }
  }

  private findEntryByName(name: string, entries: VaultEntry[]): VaultEntry | null {
    const lowerName = name.toLowerCase();
    for (const entry of entries) {
      if (entry.name.toLowerCase() === lowerName) return entry;
      if (entry.children) {
        const found = this.findEntryByName(name, entry.children);
        if (found) return found;
      }
    }
    return null;
  }

  private findEntryByBaseName(baseName: string, entries: VaultEntry[]): VaultEntry | null {
    const lowerBase = baseName.toLowerCase();
    for (const entry of entries) {
      if (entry.kind === 'file') {
        const entryName = entry.name;
        const entryBaseName = entryName.includes('.')
          ? entryName.substring(0, entryName.lastIndexOf('.'))
          : entryName;

        if (entryBaseName.toLowerCase() === lowerBase) {
          return entry;
        }
      }
      if (entry.children) {
        const found = this.findEntryByBaseName(baseName, entry.children);
        if (found) return found;
      }
    }
    return null;
  }

  cancelEdit(): void {
    this.isEditing = false;
    this.closeResourcePicker();
    this.hasBroadcastSelection = false;
    this.selectedFileName = '';
    this.selectedFileDisplayName = '';
    this.selectedFileRelativePath = '';
    this.selectedFileContent = '';
    this.processedContent = '';
    this.nonMarkdownUrl = null;
    this.isImage = false;
    this.isPdf = false;
    this.revokeObjectUrls();
  }

  openObsidianVault(): void {
    if (this.localhostRoute) {
      window.open(this.localhostRoute, '_blank');
    }
  }

  // --- Broadcast Functionality ---

  async broadcastCurrentContent(): Promise<void> {
    const selectionData = this.getCurrentBroadcastSelection();
    if (selectionData) {
      this.openBroadcastDialog(selectionData);
      return;
    }

    await this.broadcastFullDocument();
  }

  async broadcastFullDocument(): Promise<void> {
    if (!this.selectedFileContent && !this.nonMarkdownUrl) return;

    let data: BroadcastData = {
      source: 'obsidian-view',
      filename: this.selectedFileName
    };

    if (this.selectedFileName.endsWith('.md')) {
      const markdownBroadcast = await this.buildBroadcastMarkdown(this.selectedFileContent);
      data.text = markdownBroadcast.markdown;
      data.embeddedFiles = markdownBroadcast.embeddedFiles;
    } else {
      // For images/PDFs, we need to get the actual file blob or use the URL
      const blob = await this.obsidianVaultService.readFileAsBlob(this.serverId, this.selectedFileRelativePath);
      data.file = new File([blob], this.selectedFileName, { type: blob.type });
    }

    this.openBroadcastDialog(data);
  }

  async broadcastSelection(): Promise<void> {
    const data = this.getCurrentBroadcastSelection();
    if (!data) return;
    this.openBroadcastDialog(data);
  }

  private async buildBroadcastMarkdown(
    content: string,
    currentFilePath: string = this.selectedFileRelativePath,
    visitedPaths: Set<string> = new Set([this.selectedFileRelativePath.toLowerCase()])
  ): Promise<{ markdown: string; embeddedFiles: BroadcastEmbeddedFile[] }> {
    const embedRegex = /!\[\[(.*?)\]\]/g;
    let rebuiltContent = '';
    let lastIndex = 0;
    const embeddedFiles: BroadcastEmbeddedFile[] = [];

    for (const match of content.matchAll(embedRegex)) {
      const fullMatch = match[0];
      const linkContent = match[1].trim();
      const startIndex = match.index ?? 0;

      rebuiltContent += content.slice(lastIndex, startIndex);
      rebuiltContent += await this.convertObsidianEmbedToMarkdown(linkContent, currentFilePath, visitedPaths, embeddedFiles);
      lastIndex = startIndex + fullMatch.length;
    }

    rebuiltContent += content.slice(lastIndex);
    return { markdown: rebuiltContent, embeddedFiles };
  }

  private async convertObsidianEmbedToMarkdown(
    linkContent: string,
    currentFilePath: string,
    visitedPaths: Set<string>,
    embeddedFiles: BroadcastEmbeddedFile[]
  ): Promise<string> {
    const parts = linkContent.split('|');
    const filePath = parts[0].trim();
    const resolvedPath = await this.resolveEmbedPath(filePath, currentFilePath);

    if (!resolvedPath) {
      return `![[${linkContent}]]`;
    }

    if (resolvedPath.toLowerCase().endsWith('.md')) {
      const visitedKey = resolvedPath.toLowerCase();
      if (visitedPaths.has(visitedKey)) {
        return `> Embedded note skipped to avoid a recursion loop: ${filePath}\n`;
      }

      const embeddedContent = await this.obsidianVaultService.readFile(this.serverId, resolvedPath);
      const nestedVisitedPaths = new Set(visitedPaths);
      nestedVisitedPaths.add(visitedKey);
      const nestedBroadcast = await this.buildBroadcastMarkdown(embeddedContent, resolvedPath, nestedVisitedPaths);
      embeddedFiles.push(...nestedBroadcast.embeddedFiles);
      return `\n> Embedded from ${this.getDisplayName(resolvedPath.split('/').pop() || filePath)}\n>\n${nestedBroadcast.markdown}\n`;
    }

    const blob = await this.obsidianVaultService.readFileAsBlob(this.serverId, resolvedPath);
    const objectUrl = URL.createObjectURL(blob);
    this.objectUrls.push(objectUrl);

    if (this.isImageFile(resolvedPath)) {
      const altText = filePath.split('/').pop()?.split('\\').pop() || filePath;
      const file = new File([blob], altText, { type: blob.type });
      const tokenUrl = `broadcast-file://${crypto.randomUUID()}`;
      embeddedFiles.push({ tokenUrl, file });
      return `![${altText}](${tokenUrl})`;
    }

    if (this.isPdfFile(resolvedPath)) {
      const fileName = filePath.split('/').pop()?.split('\\').pop() || filePath;
      return `[${fileName}](${objectUrl})`;
    }

    const fileName = filePath.split('/').pop()?.split('\\').pop() || filePath;
    return `[${fileName}](${objectUrl})`;
  }

  private async resolveEmbedPath(filePath: string, currentFilePath: string = this.selectedFileRelativePath): Promise<string | null> {
    const currentFileDir = currentFilePath.split('/').slice(0, -1).join('/');

    try {
      await this.obsidianVaultService.readFileAsBlob(this.serverId, filePath);
      return filePath;
    } catch {
      const relativeToCurrent = this.obsidianVaultService.resolveRelativePath(currentFileDir, filePath);

      try {
        await this.obsidianVaultService.readFileAsBlob(this.serverId, relativeToCurrent);
        return relativeToCurrent;
      } catch {
        const filenameOnly = filePath.split('/').pop()?.split('\\').pop();
        return filenameOnly
          ? await this.obsidianVaultService.findFileByFilename(this.serverId, filenameOnly)
          : null;
      }
    }
  }

  private updateBroadcastSelectionState(): void {
    this.hasBroadcastSelection = !!this.getCurrentBroadcastSelection();
  }

  private getCurrentBroadcastSelection(): BroadcastData | null {
    const previewSelection = this.getPreviewSelectionBroadcastData();
    if (previewSelection) {
      return previewSelection;
    }

    const editorSelection = this.getEditorSelectionBroadcastData();
    if (editorSelection) {
      return editorSelection;
    }

    return null;
  }

  private getPreviewSelectionBroadcastData(): BroadcastData | null {
    const selection = window.getSelection();
    if (!selection || selection.rangeCount === 0 || selection.isCollapsed) {
      return null;
    }

    const range = selection.getRangeAt(0);
    let node: Node | null = range.commonAncestorContainer;
    let withinMarkdown = false;
    while (node) {
      if (node instanceof HTMLElement && node.classList.contains('obsidian-markdown')) {
        withinMarkdown = true;
        break;
      }
      node = node.parentNode;
    }

    if (!withinMarkdown) {
      return null;
    }

    const container = document.createElement('div');
    container.appendChild(range.cloneContents());
    const text = selection.toString().trim();
    const htmlContent = container.innerHTML.trim();
    const images = container.getElementsByTagName('img');

    const data: BroadcastData = {
      source: 'obsidian-view-selection'
    };

    if (text) {
      data.text = text;
    }

    if (htmlContent) {
      data.htmlContent = htmlContent;
    }

    if (images.length === 1 && container.textContent?.trim() === '') {
      data.imageUrl = images[0].src;
      data.filename = images[0].alt || this.selectedFileName || 'image';
    }

    return data.text || data.htmlContent || data.imageUrl ? data : null;
  }

  private getEditorSelectionBroadcastData(): BroadcastData | null {
    const editor = this.markdownEditor?.nativeElement;
    if (!editor) {
      return null;
    }

    const start = editor.selectionStart ?? 0;
    const end = editor.selectionEnd ?? 0;
    if (start === end) {
      return null;
    }

    const text = this.selectedFileContent.slice(start, end).trim();
    if (!text) {
      return null;
    }

    return {
      text,
      source: 'obsidian-view-editor-selection',
      filename: this.selectedFileName
    };
  }

  private broadcastImageElement(image: HTMLImageElement): void {
    this.openBroadcastDialog({
      imageUrl: image.currentSrc || image.src,
      filename: image.alt || this.selectedFileName || 'image',
      source: 'obsidian-view-image'
    });
  }

  private openBroadcastDialog(data: BroadcastData): void {
    this.dialog.open(BroadcastDialog, {
      data,
      maxWidth: '600px',
      width: '100%'
    });
  }
}
