/* ================================
   TEXT CHANNEL (MODERN GLASS)
================================ */

.chat-container {
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
  background: transparent;
  overflow: hidden;
}

/* =================================
   MESSAGES VIEWPORT
================================= */

.messages-viewport {
  flex: 1;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;

  // Top/Bottom Fade effects
  &::before, &::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 40px;
    z-index: 2;
    pointer-events: none;
  }

  &::before {
    top: 0;
    background: linear-gradient(180deg, rgba(25, 26, 31, 0.5) 0%, transparent 100%);
  }

  &::after {
    bottom: 0;
    background: linear-gradient(0deg, rgba(25, 26, 31, 0.5) 0%, transparent 100%);
  }

  .messages-scroller {
    flex: 1;
    overflow-y: auto;
    padding: 24px 16px;
    scroll-behavior: smooth;

    // Modern Scrollbar
    &::-webkit-scrollbar { width: 4px; }
    &::-webkit-scrollbar-track { background: transparent; }
    &::-webkit-scrollbar-thumb {
      background: var(--outline);
      border-radius: var(--radius-pill);
      &:hover { background: var(--brand-blue-alpha); }
    }
  }
}

/* =================================
   MESSAGE ITEM DESIGN
================================= */

.message-group {
  margin-bottom: 16px;
  position: relative;

  &.whisper {
    .message-item {
      background: rgba(255, 171, 0, 0.05);
      border-left: 3px solid #ffab00;
      border-radius: 0 var(--radius-m) var(--radius-m) 0;
    }
  }
}

.reply-context {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: 56px;
  margin-bottom: 4px;
  font-size: 12px;
  color: var(--on-surface-muted);
  opacity: 0.8;

  .reply-line-icon {
    font-size: 14px;
    width: 14px;
    height: 14px;
    transform: rotate(180deg) scaleX(-1);
  }

  .reply-author {
    font-weight: 600;
    color: var(--brand-blue);
  }

  .reply-snippet {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 400px;
