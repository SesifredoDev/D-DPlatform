  <h2 mat-dialog-title style="margin: 0; font-size: 20px;">Save Map</h2>
  <mat-dialog-content>
    <p style="font-size: 14px; color: #b5bac1;">What should we call this masterpiece?</p>
    <mat-form-field appearance="outline">
      <mat-label>Map Name</mat-label>
      <input matInput [(ngModel)]="data.name" placeholder="e.g. Dragon's Lair" (keyup.enter)="dialogRef.close(data.name)">
    </mat-form-field>
  </mat-dialog-content>
  <div class="actions">
    <button mat-button (click)="dialogRef.close()">Cancel</button>
    <button class="save-btn" mat-raised-button (click)="dialogRef.close(data.name)">Save Map</button>
  </div>
</div>
