}

/* =================================
   CHARACTER OVERLAY (RPG STYLE)
================================= */

.character-overlay {
  position: absolute;
  inset: 0;
  padding: min(4cqw, 12px);
  display: flex;
  flex-direction: column;
  justify-content: flex-end; // Align frame to bottom
