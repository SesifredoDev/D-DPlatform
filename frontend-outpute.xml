  line-height: 1.55;
  color: var(--on-surface);
  word-wrap: break-word;
  word-break: break-word;

  ::ng-deep {
    p { margin: 0 0 6px 0;
      img{
        max-width: 50%;

      }
    }
    p:last-child { margin-bottom: 0; }
  }
}

.message-attachments {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;

  .attachment-image {
