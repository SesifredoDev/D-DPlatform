<div class="map-drawer-container" [class.open]="showLibraryOverlay" *ngIf="!syncService.isConnected || syncService.isHosting">
  <div class="drawer-toggle" (click)="showLibraryOverlay = !showLibraryOverlay">
    <mat-icon>{{ showLibraryOverlay ? 'keyboard_double_arrow_down' : 'map' }}</mat-icon>
    <span class="toggle-text">{{ showLibraryOverlay ? 'CLOSE LIBRARY' : 'OPEN MAP LIBRARY' }}</span>
  </div>

  <div class="drawer-content">
    <div class="library-grid">
      <div class="library-card new-map-card" (click)="createNewMap()">
        <div class="thumbnail-placeholder">
          <mat-icon>add_location_alt</mat-icon>
        </div>
        <span class="map-label">Create New</span>
      </div>

      <ng-container *ngFor="let map of mapLibrary">
        <div class="library-card" *ngIf="!map.isArchived" (click)="loadFromLibrary(map)">
          <div class="thumbnail" [style.backgroundImage]="'url(' + map.data.mapUrl + ')'">
            <div class="card-actions">
              <button (click)="toggleArchive(map, $event)" title="Archive" [disabled]="map.id == currentMapId" *ngIf="map.id !== currentMapId">
                <mat-icon>inventory_2</mat-icon>
              </button>
            </div>
            <div class="overlay-stats">
              <mat-icon>history</mat-icon>
              {{ map.lastSaved | date:'shortDate' }}
            </div>
          </div>
          <span class="map-label">{{ map.name }}</span>
        </div>
      </ng-container>
    </div>

    <hr class="divider" *ngIf="mapLibrary.length > 0">

    <div class="archive-section" *ngIf="mapLibrary.length > 0">
      <h4><mat-icon>archive</mat-icon> Archived Maps</h4>
      <div class="library-grid">
        <ng-container *ngFor="let map of mapLibrary">
          <div class="library-card archived" *ngIf="map.isArchived">
            <div class="thumbnail" [style.backgroundImage]="'url(' + map.data.mapUrl + ')'">
              <div class="card-actions">
                <button (click)="toggleArchive(map, $event)" title="Restore">
                  <mat-icon>unarchive</mat-icon>
                </button>
                <button (click)="deleteMap(map, $event)" class="btn-danger" title="Delete" >
                  <mat-icon>delete_forever</mat-icon>
                </button>
              </div>
            </div>
            <span class="map-label">{{ map.name }}</span>
          </div>
        </ng-container>
      </div>
    </div>
  </div>
</div>

<div class="current-map-indicator" *ngIf="currentMapName">
  <mat-icon>auto_stories</mat-icon>
  <span>{{ currentMapName }}</span>
</div>

<div id="toolbar-wrapper">
  <div id="toolbar" class="glass">
    <!-- Map Management Tools -->
    <div class="tool-group" *ngIf="!syncService.isConnected || syncService.isHosting">
      <button mat-icon-button (click)="saveCurrentMap(false)" matTooltip="Save to Library">
        <mat-icon>save</mat-icon>
      </button>
      <button mat-icon-button (click)="exportMapJson()" matTooltip="Download/Export Map JSON">
        <mat-icon>file_download</mat-icon>
      </button>
      <button mat-icon-button (click)="mapJsonInput.click()" matTooltip="Upload/Import Map JSON">
        <mat-icon>file_upload</mat-icon>
      </button>
      <input #mapJsonInput type="file" (change)="onMapJsonUpload($event)" accept=".json" style="display: none" />

      <button mat-icon-button (click)="fileInput.click()" matTooltip="Set Background Image">
        <mat-icon>image</mat-icon>
      </button>
      <input #fileInput type="file" (change)="onMapUpload($event)" accept="image/*" style="display: none" />
    </div>

    <!-- Core Interaction Tools -->
    <div class="tool-group">
      <button mat-icon-button [class.active]="activeTool === 'select'" (click)="setTool('select')" matTooltip="Select/Move">
        <mat-icon>near_me</mat-icon>
      </button>
      <button mat-icon-button [class.active]="activeTool === 'line'" (click)="setMeasureTool('line')" matTooltip="Measure Line">
        <mat-icon>straighten</mat-icon>
      </button>
      <button mat-icon-button [class.active]="activeTool === 'radius'" (click)="setMeasureTool('radius')" matTooltip="Measure Radius">
        <mat-icon>blur_circular</mat-icon>
      </button>
    </div>

    <!-- Wall/Drawing Tools (DM Only) -->
    <div class="tool-group" *ngIf="!syncService.isConnected || syncService.isHosting" >
      <button mat-icon-button [class.active]="activeTool === 'draw'" (click)="setTool('draw')" matTooltip="Draw Walls">
        <mat-icon>edit_road</mat-icon>
      </button>
      <button mat-icon-button [class.active]="activeTool === 'delete'" (click)="setTool('delete')" matTooltip="Erase Walls">
        <mat-icon>auto_fix_off</mat-icon>
      </button>
    </div>

    <!-- Token Management & Lighting (DM Only) -->
    <div class="tool-group" *ngIf="syncService.isHosting">
      <button mat-icon-button (click)="addPlayer()" matTooltip="Add Player Token">
        <mat-icon>person_add</mat-icon>
      </button>
      <button mat-icon-button (click)="addToken()" matTooltip="Add Monster Token">
        <mat-icon>person</mat-icon>
      </button>
      <button mat-icon-button (click)="toggleLighting()" [class.active-light]="lightingEnabled" matTooltip="Toggle Lighting">
        <mat-icon>{{ lightingEnabled ? 'lightbulb' : 'lightbulb_outline' }}</mat-icon>
      </button>
    </div>

    <!-- Turn Order (DM Only Initial Control) -->
    <div class="tool-group" *ngIf="syncService.isHosting">
      <button mat-icon-button (click)="activateTurnOrder()" *ngIf="!(turnOrderState$ | async)?.isActive" matTooltip="Activate Turn Order">
        <mat-icon>format_list_numbered</mat-icon>
      </button>
    </div>

    <!-- Session Management -->
    <div class="tool-group">
      <button mat-icon-button *ngIf="!syncService.isConnected" (click)="startHostingSession()" matTooltip="Host Session">
        <mat-icon>podcasts</mat-icon>
      </button>
      <button mat-icon-button *ngIf="syncService.isConnected" (click)="stopSession()" matTooltip="Stop Session" color="warn">
        <mat-icon>stop_circle</mat-icon>
      </button>
      <!-- Host Takeover Button -->
      <button mat-button color="accent" *ngIf="showHostTakeover" (click)="startHostingSession()" class="takeover-btn">
        <mat-icon>stadium</mat-icon>
        Assume Hosting
      </button>
    </div>

    <!-- Settings/Utilities -->
    <div class="tool-group" *ngIf="!syncService.isConnected || syncService.isHosting">
      <div class="input-wrapper" matTooltip="Grid Size (px)">
        <mat-icon class="tiny">grid_on</mat-icon>
        <input type="number" [value]="engine?.gridSize" (change)="engine.updateGridSize($any($event.target).value)">
      </div>
    </div>
  </div>
</div>

<div #vttContainer id="vtt-container"></div>

<!-- Map Loading Overlay -->
<div class="map-loading-overlay" *ngIf="(syncService.mapLoading$ | async)?.loading">
  <div class="loading-content glass">
    <div class="spinner"></div>
    <div class="loading-text">{{ (syncService.mapLoading$ | async)?.message }}</div>
    <div class="progress-bar-container" *ngIf="(syncService.mapLoading$ | async)?.progress">
      <div class="progress-bar" [style.width.%]="(syncService.mapLoading$ | async)?.progress"></div>
    </div>
  </div>
</div>

<!-- Turn Order Display -->
<div class="turn-order-overlay glass" *ngIf="(turnOrderState$ | async) as turnOrder" [hidden]="!turnOrder.isActive" [class.minimized]="turnOrderMinimized">
  <div class="turn-order-header" (click)="toggleTurnOrderMinimize()">
    <mat-icon class="minimize-icon">{{ turnOrderMinimized ? 'expand_more' : 'expand_less' }}</mat-icon>
    <h3>Turn Order</h3>
    <div class="dm-controls" *ngIf="syncService.isHosting && !turnOrderMinimized" (click)="$event.stopPropagation()">
      <button mat-icon-button (click)="confirmTurnOrder()" *ngIf="!turnOrder.isConfirmed" title="Confirm and Sort">
        <mat-icon color="primary">check_circle</mat-icon>
      </button>
      <button mat-icon-button (click)="endTurnOrder()" title="End Turn Order">
        <mat-icon color="warn">cancel</mat-icon>
      </button>
    </div>
  </div>

  <div class="turn-order-content" *ngIf="!turnOrderMinimized">
      <div class="active-turn-indicator" *ngIf="turnOrder.isConfirmed && turnOrder.entries.length > 0">
          <div class="active-name">Current: <b>{{ turnOrder.entries[turnOrder.activeIndex]?.name }}</b></div>
          <div class="turn-controls" *ngIf="syncService.isHosting">
              <button mat-icon-button (click)="prevTurn()"><mat-icon>navigate_before</mat-icon></button>
              <button mat-icon-button (click)="nextTurn()"><mat-icon>navigate_next</mat-icon></button>
          </div>
      </div>

      <div class="turn-order-entries">
        <div class="turn-entry" *ngFor="let entry of turnOrder.entries; let i = index" [class.active-entry]="turnOrder.isConfirmed && i === turnOrder.activeIndex">
          <span class="initiative">{{ entry.initiative }}</span>
          <span class="name">{{ entry.name }}</span>
          <button mat-icon-button *ngIf="syncService.isHosting" (click)="removeTurnOrderEntry(entry.id)" class="small-icon">
            <mat-icon>close</mat-icon>
          </button>
        </div>
      </div>

      <div class="turn-order-input" *ngIf="!turnOrder.isConfirmed || syncService.isHosting">
        <input type="text" [(ngModel)]="newEntryName" placeholder="Name" class="name-input">
        <input type="number" [(ngModel)]="newEntryInitiative" placeholder="Init" class="init-input">
        <button mat-icon-button (click)="addTurnOrderEntry()" [disabled]="!newEntryName">
          <mat-icon>add_circle</mat-icon>
        </button>
      </div>
  </div>
</div>


<!-- Hidden Trigger for Token Menu -->
<div style="visibility: hidden; position: fixed"
     [style.left]="menuTopLeftPosition.x"
     [style.top]="menuTopLeftPosition.y"
     [matMenuTriggerFor]="tokenMenu">
</div>

<mat-menu #tokenMenu="matMenu" class="token-config-menu">
  <div class="menu-content" (click)="$event.stopPropagation()">
    <div class="menu-header">
      <mat-icon>settings</mat-icon>
      <h3>Token Config</h3>
    </div>

    <div class="token-preview-area">
      <div class="preview-circle" [style.background-image]="tokenEditConfig.icon ? 'url(' + tokenEditConfig.icon + ')' : 'none'"
           [style.background-color]="!tokenEditConfig.icon ? tokenEditConfig.color : 'transparent'"
           [style.border-color]="tokenEditConfig.forceBorder ? tokenEditConfig.borderColor : '#fff'"
           [style.border-width]="tokenEditConfig.forceBorder ? '4px' : '2px'">
      </div>
      <label class="icon-upload-btn">
        <mat-icon>photo_camera</mat-icon>
        <input type="file" (change)="onTokenIconUpload($event)" accept="image/*" hidden>
      </label>
    </div>

    <mat-form-field appearance="fill" class="full-width compact">
      <mat-label>Name</mat-label>
      <input matInput [(ngModel)]="tokenEditConfig.name">
    </mat-form-field>

    <div class="config-row">
      <mat-form-field appearance="fill" class="half-width compact">
        <mat-label>Size</mat-label>
        <mat-select [(ngModel)]="tokenEditConfig.size">
          <mat-option [value]="0.5">Small (0.5)</mat-option>
          <mat-option [value]="1">Standard (1)</mat-option>
          <mat-option [value]="2">Large (2)</mat-option>
          <mat-option [value]="3">Huge (3)</mat-option>
        </mat-select>
      </mat-form-field>

      <div class="checkbox-container">
        <mat-checkbox [(ngModel)]="tokenEditConfig.forceBorder">Border</mat-checkbox>
      </div>
    </div>

    <div class="color-picker-section">
      <span class="section-label">{{ tokenEditConfig.forceBorder ? 'Border Color' : 'Token Color' }}</span>
      <div class="color-grid">
        <div *ngFor="let color of colorPresets"
             class="color-swatch"
             [style.background-color]="color"
             [class.active]="(tokenEditConfig.forceBorder ? tokenEditConfig.borderColor : tokenEditConfig.color) === color"
             (click)="selectColor(color)">
        </div>
      </div>
    </div>

    <div class="menu-footer">
      <button mat-icon-button color="warn" (click)="deleteSelectedToken()" matTooltip="Delete Token">
        <mat-icon>delete</mat-icon>
      </button>
      <button mat-raised-button color="primary" (click)="applyTokenConfig()">
        Save Changes
      </button>
    </div>
  </div>
</mat-menu>
</file>

