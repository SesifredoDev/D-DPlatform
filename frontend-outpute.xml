      border-radius: var(--radius-pill);
      background: rgba(0,0,0,0.4);
      position: relative;
      overflow: hidden;

      &::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; border-radius: inherit; }
      &.hp::after { width: 100%; background: linear-gradient(90deg, #ff4d4d, #ff8080); }
      &.resource::after { width: 85%; background: linear-gradient(90deg, #4da6ff, #80bfff); }
    }
  }
}

/* STATS HOVER CARD (REFINED) */

.character-hover-card {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: min(90%, 280px);
  padding: 16px;
  background: rgba(30, 31, 34, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--brand-blue-alpha);
