    </button>

    <ng-container *ngIf="isServerOwner">
      <button
        mat-icon-button
        (click)="openObsidian()"
        matTooltip="Link Local Obsidian Vault">
        <mat-icon>folder_special</mat-icon>
      </button>
    </ng-container>

  </div>

