<file path="src/app/pages/dashboard/side-panel/side-panel.scss">
/* ================================
   SIDEBAR CONTAINER (GLASS)
================================ */

.sidebar-container {
  height: 100vh;
  width: 20vw;
  min-width: 280px;
  max-width: 420px;

  display: flex;
  flex-direction: column;

  // Glassmorphism Base
  background: rgba(25, 26, 31, 0.65);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-right: 1px solid var(--outline);

  font-family: var(--font-family-main, "Inter", system-ui, sans-serif);
  color: var(--on-background);
  overflow: hidden;
}

/* =================================
   SCROLLBAR (MODERN)
================================= */

.sidebar-container ::-webkit-scrollbar {
  width: 4px;
}

.sidebar-container ::-webkit-scrollbar-thumb {
  background: var(--outline);
  border-radius: var(--radius-pill);
}

.sidebar-container ::-webkit-scrollbar-thumb:hover {
  background: var(--on-surface-variant);
}

/* =================================
   TOP SECTION & CHARACTER SELECT
================================= */

.top-section {
  padding: var(--space-m);
  border-bottom: 1px solid var(--surface-variant);
  background: rgba(255, 255, 255, 0.02);
}

.selector-row {
  display: flex;
  align-items: center;
  gap: var(--space-s);
  width: 100%;
}

.manage-chars-btn {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-l);
  background: var(--surface-light);
  border: 1px solid var(--outline);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition-standard);

  mat-icon {
    font-size: 20px;
    width: 20px;
    height: 20px;
    color: var(--on-surface-muted);
  }

  &:hover {
    background: var(--brand-blue-alpha);
    border-color: var(--brand-blue);
    transform: translateY(-1px);
    mat-icon { color: white; }
  }
}

.character-select {
  flex: 1;
  // Deep override for modern look
  ::ng-deep {
    .mat-mdc-text-field-wrapper {
      background-color: var(--surface-light) !important;
      border-radius: var(--radius-l) !important;
      border: 1px solid var(--outline) !important;
    }
    .mat-mdc-form-field-focus-indicator { display: none; }
    .mat-mdc-form-field-subscript-wrapper { display: none; }
  }
}

/* =================================
   PROFILE CARD (REFINED)
================================= */

.profile-card {
  margin-top: var(--space-m);
  display: flex;
  gap: var(--space-m);
  align-items: center;
  padding: var(--space-s) var(--space-m);
  border-radius: var(--radius-l);
  background: var(--surface-variant);
  border: 1px solid var(--outline);
  transition: all var(--transition-standard);

  &:hover {
    background: var(--surface-lighter);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }
}

.avatar-img {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-m);
  object-fit: cover;
  box-shadow: var(--shadow-1);
}

.profile-text {
  display: flex;
  flex-direction: column;
}

.character-name {
  font-size: 15px;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.character-sub {
  font-size: 12px;
  color: var(--on-surface-muted);
}

/* =================================
   CHANNELS (CLEAN)
================================= */

.middle-section {
  padding: var(--space-s) 0;
  border-bottom: 1px solid var(--surface-variant);
}

.category-header {
  padding: var(--space-s) var(--space-m);
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
  color: var(--on-surface-muted);

  mat-icon {
    font-size: 14px;
    width: 14px;
    height: 14px;
  }
}

.channel-list {
  padding: 0 var(--space-s);
}

.channel-item {
  height: 40px !important;
  margin: 2px 0;
  border-radius: var(--radius-m) !important;
  font-size: 14px;
  transition: all var(--transition-fast) !important;

  &:hover {
    background: var(--surface-light) !important;
    color: var(--on-background) !important;
    transform: translateX(2px);
  }

  &.active-channel {
    background: var(--brand-blue-alpha) !important;
    color: white !important;
    font-weight: 500;

    &::before {
      content: '';
      position: absolute;
      left: 0;
      height: 16px;
      width: 4px;
      background: var(--brand-blue);
      border-radius: 0 4px 4px 0;
    }
  }
}

.channel-icon {
  margin-right: 8px !important;
  color: var(--on-surface-variant);
  font-size: 18px !important;
  width: 18px !important;
  height: 18px !important;
}

/* =================================
   WHISPERS (NEW)
================================= */

.whisper-section {
  padding: var(--space-s) 0;
  border-bottom: 1px solid var(--surface-variant);
  max-height: 250px;
  display: flex;
  flex-direction: column;
}

.whisper-list {
  padding: 0 var(--space-s);
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.whisper-button {
  width: 100%;
  justify-content: flex-start !important;
  height: 40px !important;
  border-radius: var(--radius-m) !important;
  font-size: 14px !important;
  transition: all var(--transition-fast) !important;
  padding: 0 var(--space-s) !important;
  color: var(--on-surface-variant) !important;

  &:hover {
    background: var(--surface-light) !important;
    color: var(--on-background) !important;
    transform: translateX(2px);
  }

  mat-icon {
    margin-right: 8px;
    font-size: 18px;
    width: 18px;
    height: 18px;
  }

  .whisper-avatar {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-s);
    margin-right: 8px;
    object-fit: cover;
  }
}

/* =================================
   MEMBER LIST (GLASS ROWS)
================================= */

.member-sidebar {
  flex: 1;
  overflow-y: auto;
  padding: var(--space-m) var(--space-s);
}

.role-group {
  margin-bottom: var(--space-m);
}

.role-header {
  padding: var(--space-s) var(--space-s);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.8px;
  color: var(--on-surface-muted);
  display: flex;
  justify-content: space-between;
}

.member-row {
  display: flex;
  gap: 12px;
  padding: var(--space-s);
  border-radius: var(--radius-l);
  margin-bottom: 4px;
  transition: all var(--transition-standard);
  cursor: pointer;

  &:hover {
    background: var(--surface-light);
    .member-avatar { border-color: var(--brand-blue); }
  }
}

.member-avatar {
  width: 34px;
  height: 34px;
  border-radius: var(--radius-m);
  border: 2px solid transparent;
  object-fit: cover;
  transition: border-color var(--transition-fast);
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 14px;
  font-weight: 500;
  color: var(--on-surface);
}

/* =================================
   CHARACTER CHIPS
================================= */

.character-row {
  margin-top: 4px;
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
}

.character-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 2px 8px;
  font-size: 11px;
  border-radius: var(--radius-pill);
  background: var(--surface-variant);
  border: 1px solid var(--outline);
  color: var(--on-surface-muted);
  transition: all var(--transition-fast);

  &:hover {
    background: var(--brand-blue-alpha);
    border-color: var(--brand-blue);
    color: white;
    transform: translateY(-1px);
  }

  .char-icon {
    width: 14px;
    height: 14px;
    border-radius: var(--radius-round);
    object-fit: cover;
  }
}

/* =================================
   BOTTOM & CONTROLS (FLOAT)
================================= */

.bottom-section {
  padding: var(--space-s) var(--space-m);
  background: rgba(0, 0, 0, 0.1);
  border-top: 1px solid var(--surface-variant);
}

.server-btn {
  width: 100%;
  height: 44px !important;
  border-radius: var(--radius-l) !important;
  background: var(--surface-light) !important;
  border: 1px solid var(--outline) !important;
  color: var(--on-background) !important;
  transition: all var(--transition-standard) !important;
  padding: 0 12px !important;
  display: flex !important;
  align-items: center;
  justify-content: space-between;

  &:hover {
    background: var(--surface-lighter) !important;
    border-color: var(--brand-blue) !important;
    transform: translateY(-1px);
  }

  .server-info-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    overflow: hidden;
  }

  .btn-text {
    flex: 1;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chevron {
    font-size: 18px;
    width: 18px;
    height: 18px;
    margin-left: 4px;
  }
}

.server-icon, .server-icon-placeholder {
  width: 28px;
  height: 28px;
  border-radius: var(--radius-s);
  object-fit: cover;
}

.server-icon-placeholder {
  background: var(--brand-blue);
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: bold;
}

/* =================================
   SERVER MENU STYLING
================================= */

::ng-deep .server-select-menu {
  background: rgba(30, 31, 38, 0.95) !important;
  backdrop-filter: blur(10px);
  border: 1px solid var(--outline);
  border-radius: var(--radius-l) !important;
  min-width: 240px !important;

  .menu-header {
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    color: var(--on-surface-muted);
    border-bottom: 1px solid var(--surface-variant);
    margin-bottom: 4px;
  }

  .mat-mdc-menu-content {
    padding: 4px !important;
  }

  .mat-mdc-menu-item {
    border-radius: var(--radius-m) !important;
    margin: 2px 0;
    height: 44px !important;

    &:hover {
      background: var(--surface-light) !important;
    }

    &.active-server {
      background: var(--brand-blue-alpha) !important;
      color: white;
    }
  }
}

.server-menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;

  .server-icon-mini, .server-icon-placeholder.mini {
    width: 24px;
    height: 24px;
    border-radius: 4px;
    font-size: 12px;
  }

  span {
    flex: 1;
    font-size: 14px;
  }

  .active-check {
    font-size: 18px;
    width: 18px;
    height: 18px;
    color: var(--brand-blue);
  }
}

.user-controls {
  display: flex;
  justify-content: space-around;
  padding: var(--space-s);
  border-top: 1px solid var(--surface-variant);
  background: rgba(255, 255, 255, 0.03);

  button {
    background: var(--surface-light);
    border-radius: var(--radius-m);
    color: var(--on-surface-muted);
    transition: all var(--transition-standard);

    &:hover {
      background: var(--brand-blue-alpha);
      color: white;
      transform: translateY(-2px);
    }
  }
}

/* =================================
   MOBILE ADAPTATION
================================= */

@media (max-width: 900px) {
  .sidebar-container { width: 260px; }
}
</file>

<file path="src/app/pages/dashboard/text-channel/text-channel.html">
<div class="chat-container" [class.whisper-channel]="isWhisperMode">
  @if(showNewMessageIndicator){
    <div class="new-message-indicator" (click)="scrollToBottom(true)">
      <mat-icon>arrow_downward</mat-icon>
      <span>New Messages Below</span>
    </div>
  }

  <div class="messages-viewport">
    <div #messageContainer class="messages-scroller" (scroll)="onScroll()">
      @for (msg of messages; track msg._id; let i = $index) {
        <div class="message-group" [id]="msg._id" [class.whisper]="msg.isWhisper">

          @if(msg.replyTo) {
            <div class="reply-context">
              <mat-icon class="reply-line-icon">reply</mat-icon>
              <span class="reply-author">@{{ msg.replyTo.character?.name || msg.replyTo.author?.username }}</span>
              <span class="reply-snippet">{{ msg.replyTo.content }}</span>
            </div>
          }

          <div class="message-item">
            <div class="avatar-column">
              <img
                [src]="msg.character?.icon || msg.author?.profileIcon || 'https://www.gravatar.com/avatar/'+(msg.character?._id || msg.author?._id)+'?d=identicon'"
                class="user-avatar"
                alt="Avatar"
                (error)="$any($event.target).src = 'assets/default-avatar.png'">
            </div>

            <div class="content-column">
              <div class="message-meta">
                <span class="author-name">{{ msg.character?.name || msg.author?.username }}</span>
                @if(msg.isWhisper && !isWhisperMode) {
                  <span class="whisper-label">
                    <mat-icon>visibility_off</mat-icon>
                    Whisper to {{ msg.recipient?.username || 'the DM' }}
                  </span>
                }
                <span class="timestamp">{{ msg.createdAt | date:'HH:mm' }}</span>
              </div>

              <div class="message-text">
                <markdown [data]="msg.content"></markdown>
              </div>

              @if(msg.attachments && msg.attachments.length > 0) {
                <div class="message-attachments">
                  @for(att of msg.attachments; track att.url) {
                    <div class="attachment-item">
                      @if(att.contentType?.startsWith('image/')) {
                        <img [src]="att.url" [alt]="att.name" class="attachment-image">
                      } @else {
                        <a [href]="att.url" target="_blank" class="attachment-file">
                          <mat-icon>insert_drive_file</mat-icon>
                          <span>{{ att.name }}</span>
                        </a>
                      }
                    </div>
                  }
                </div>
              }

              @if(msg.reactions && msg.reactions.length > 0) {
                <div class="message-reactions">
                  @for(reaction of msg.reactions; track reaction.emoji) {
                    <div class="reaction-chip" [class.active]="reaction.users.includes(currentUserId!)" (click)="toggleReaction(msg, reaction.emoji)">
                      <span class="emoji">{{ reaction.emoji }}</span>
                      <span class="count">{{ reaction.users.length }}</span>
                    </div>
                  }
                </div>
              }
            </div>

            <div class="message-actions">
              <button mat-icon-button class="action-btn" [matMenuTriggerFor]="emojiMenu" matTooltip="Add Reaction">
                <mat-icon>add_reaction</mat-icon>
              </button>
              <mat-menu #emojiMenu="matMenu">
                <div class="emoji-picker-mini">
                  <button mat-menu-item (click)="addReaction(msg._id, '👍')">👍</button>
                  <button mat-menu-item (click)="addReaction(msg._id, '❤️')">❤️</button>
                  <button mat-menu-item (click)="addReaction(msg._id, '😂')">😂</button>
                  <button mat-menu-item (click)="addReaction(msg._id, '😮')">😮</button>
                  <button mat-menu-item (click)="addReaction(msg._id, '😢')">😢</button>
                </div>
              </mat-menu>
              <button mat-icon-button class="action-btn" (click)="setReply(msg)" matTooltip="Reply">
                <mat-icon>reply</mat-icon>
              </button>
            </div>
          </div>
        </div>
      } @empty {
        <div class="empty-state">
          <div class="empty-icon-wrapper">
            <mat-icon>{{ isWhisperMode ? 'visibility_off' : 'forum' }}</mat-icon>
          </div>
          <h3>{{ isWhisperMode ? 'Private Whisper Channel' : 'Welcome to the Chronicle' }}</h3>
          <p>{{ isWhisperMode ? 'This channel is only visible to you and ' + (whisperRecipient?.username || 'the DM') : 'This is the start of your adventure. Scribe your first message below.' }}</p>
        </div>
      }
    </div>
  </div>

  <div class="input-container">
    @if(attachments.length > 0) {
      <div class="attachment-preview-strip">
        @for(att of attachments; track att.url; let i = $index) {
          <div class="attachment-preview">
             <mat-icon>insert_drive_file</mat-icon>
             <span>{{ att.name }}</span>
             <button mat-icon-button (click)="removeAttachment(i)"><mat-icon>close</mat-icon></button>
          </div>
        }
      </div>
    }

    @if(replyingTo) {
      <div class="reply-preview">
        <span>Replying to <strong>{{ replyingTo.character?.name || replyingTo.author?.username }}</strong></span>
        <button mat-icon-button (click)="cancelReply()"><mat-icon>close</mat-icon></button>
      </div>
    }

    @if(isWhisperMode) {
      <div class="whisper-preview">
        <mat-icon>visibility_off</mat-icon>
        <span>Whispering to <strong>{{ whisperRecipient?.username || 'the DM' }}</strong></span>
      </div>
    }

    <div class="input-box" [class.has-reply]="replyingTo" [class.has-attachments]="attachments.length > 0" [class.whisper-mode]="isWhisperMode">
      <textarea
        #messageInput
        [placeholder]="isWhisperMode ? 'Scribe a whisper...' : 'Scribe a message to the chronicle...'"
        [(ngModel)]="newMessageContent"
        (keydown)="handleKeyDown($event)"
        cdkTextareaAutosize
        #autosize="cdkTextareaAutosize"
        cdkAutosizeMinRows="1"
        cdkAutosizeMaxRows="10">
      </textarea>

      <div class="input-actions">
        <button mat-icon-button class="action-btn" (click)="fileInput.click()" [disabled]="isUploading">
          <mat-icon>{{ isUploading ? 'sync' : 'attach_file' }}</mat-icon>
        </button>
        <input type="file" #fileInput style="display: none" (change)="onFileSelected($event)">

        <button
          mat-icon-button
          class="send-btn"
          (click)="sendMessage()"
          [disabled]="(!newMessageContent.trim() && attachments.length === 0) || isUploading"
          [class.can-send]="newMessageContent.trim() || attachments.length > 0">
          <mat-icon>send</mat-icon>
        </button>
      </div>
    </div>
  </div>
</div>
</file>

