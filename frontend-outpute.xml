<file path="src/app/shared/services/playlist/spotify.service.ts">
import { Injectable } from '@angular/core';
import { HttpClient, HttpHeaders, HttpParams } from '@angular/common/http';
import { BehaviorSubject, firstValueFrom, interval, Subscription, of, Subject, Observable } from 'rxjs';
import { startWith, switchMap, catchError, map, tap } from 'rxjs/operators';

import {environment} from '../../../../environments/environment';

declare global {
  interface Window { onSpotifyWebPlaybackSDKReady: () => void; Spotify: any; }
}

export interface SpotifySearchResult {
  id: string;
  name: string;
  uri: string;
  type: 'track' | 'playlist' | 'album' | 'artist' | 'show' | 'episode' | 'audiobook' | 'user';
  image: string;
  artist?: string;
  artistId?: string;
  owner?: string;
  ownerId?: string;
  publisher?: string;
}

export interface SpotifyDevice {
  id: string;
  is_active: boolean;
  is_private_session: boolean;
  is_restricted: boolean;
  name: string;
  type: string;
  volume_percent: number;
}

export interface SpotifySyncEvent {
  command: string;
  data: any;
  source: 'manual' | 'auto';
}

@Injectable({ providedIn: 'root' })
export class SpotifyService {
  private player: any;
  private sdkDeviceId: string | null = null;
  private accessToken: string | null = null;
  private pollingSub: Subscription | null = null;

  public isReady$ = new BehaviorSubject<boolean>(false);
  public currentTrack$ = new BehaviorSubject<any>(null);
  public isPaused$ = new BehaviorSubject<boolean>(true);
  public shuffleState$ = new BehaviorSubject<boolean>(false);
  public queue$ = new BehaviorSubject<any[]>([]);
  public isAuthorized$ = new BehaviorSubject<boolean>(false);
  public error$ = new BehaviorSubject<string | null>(null);
  public devices$ = new BehaviorSubject<SpotifyDevice[]>([]);
  public activeDeviceId$ = new BehaviorSubject<string | null>(null);
  public savedPlaylists$ = new BehaviorSubject<any[]>([]);
  public recentPlays$ = new BehaviorSubject<any[]>([]);
  public pinnedItems$ = new BehaviorSubject<any[]>([]);

  // Event emitted when local user takes an action that should be synced
  public syncAction$ = new Subject<SpotifySyncEvent>();

  // Track the last state we synced to avoid loops and detect external changes
  private lastSyncedUri: string | null = null;
  private lastSyncedPaused: boolean | null = null;
  private lastSyncedPosition: number = 0;
  private lastSyncedShuffle: boolean = false;
  private lastSyncedContextUri: string | null = null;
  private lastCheckTime: number = 0;
  public lastActionTime: number = 0;
  private isFirstPoll: boolean = true;

  private readonly API_BASE = 'https://api.spotify.com/v1';
  private readonly BACKEND_API = `${environment.apiURL}`;

  constructor(private http: HttpClient) {
    this.accessToken = localStorage.getItem('spotify_access_token');
    this.loadPinned();
    if (this.accessToken) {
      this.isAuthorized$.next(true);
      this.initSDK();
      this.startPolling();
      this.loadUserData();
    }
  }

  getAccessToken(): string | null {
    return this.accessToken;
  }

  refreshSpotifyToken(): Observable<string> {
    const refreshToken = localStorage.getItem('spotify_refresh_token');
    return this.http.post<{ accessToken: string }>(`${this.BACKEND_API}spotify/refresh`, { refresh_token: refreshToken }).pipe(
      map(res => res.accessToken),
      tap(token => {
        this.accessToken = token;
        localStorage.setItem('spotify_access_token', token);
      })
    );
  }

  setTokens(access: string, refresh: string) {
    this.accessToken = access;
    localStorage.setItem('spotify_access_token', access);
    localStorage.setItem('spotify_refresh_token', refresh);
    this.isAuthorized$.next(true);
    this.error$.next(null);
    this.initSDK();
    this.startPolling();
    this.loadUserData();
  }

  private loadUserData() {
    this.loadSavedPlaylists();
    this.loadRecentPlays();
    this.loadQueue();
  }

  logout() {
    this.stopPolling();
    this.killPlayer();
    this.accessToken = null;
    localStorage.removeItem('spotify_access_token');
    localStorage.removeItem('spotify_refresh_token');
    this.isAuthorized$.next(false);
    this.isReady$.next(false);
    this.error$.next(null);
    this.devices$.next([]);
    this.activeDeviceId$.next(null);
    this.savedPlaylists$.next([]);
    this.recentPlays$.next([]);
    this.queue$.next([]);
  }

  private startPolling() {
    this.stopPolling();
    this.pollingSub = interval(5000)
      .pipe(
        startWith(0),
        switchMap(() => this.getPlaybackState()),
        catchError(() => of(null))
      )
      .subscribe(state => {
        if (state) {
          this.checkAndEmitSync(state);
          this.isPaused$.next(state.paused);
          this.shuffleState$.next(state.shuffle_state);
          this.currentTrack$.next(state.track_window?.current_track);
        }
        this.getDevices().then(devices => {
          this.devices$.next(devices);
          const active = devices.find(d => d.is_active);
          if (active) {
            this.activeDeviceId$.next(active.id);
          }
        });
      });
  }

  private stopPolling() {
    if (this.pollingSub) {
      this.pollingSub.unsubscribe();
      this.pollingSub = null;
    }
  }

  private updateSyncCache(uri: string | null, paused: boolean, position: number, shuffle: boolean, contextUri: string | null) {
      this.lastSyncedUri = uri;
      this.lastSyncedPaused = paused;
      this.lastSyncedPosition = position;
      this.lastSyncedShuffle = shuffle;
      this.lastSyncedContextUri = contextUri;
      this.lastCheckTime = Date.now();
  }

  private checkAndEmitSync(state: any) {
    if (!state) return;
    const now = Date.now();
    const newUri = state.track_window?.current_track?.uri;
    const newPaused = !!state.paused;
    const newPosition = state.position;
    const newContextUri = state.context?.uri;
    const newShuffle = !!state.shuffle_state;

    // Cooldown check: if we just took a manual action, ignore state polls that don't match our latest intent.
    // This prevents API latency from broadcasting the "old" song immediately after we switched.
    if (now - this.lastActionTime < 5000) {
        if (newUri !== this.lastSyncedUri || newPaused !== this.lastSyncedPaused) {
            return;
        }
    }

    let isSeeked = false;
    if (newUri && this.lastSyncedUri === newUri && !newPaused && !this.lastSyncedPaused) {
        const expectedPosition = this.lastSyncedPosition + (now - this.lastCheckTime);
        if (Math.abs(newPosition - expectedPosition) > 10000) { // 10s threshold
            isSeeked = true;
        }
    }

    const hasChanged = newUri && (
        newUri !== this.lastSyncedUri ||
        newPaused !== this.lastSyncedPaused ||
        newShuffle !== this.lastSyncedShuffle ||
        newContextUri !== this.lastSyncedContextUri ||
        isSeeked
    );

    if (hasChanged) {
      if (!this.isFirstPoll) {
        this.syncAction$.next({
          command: isSeeked ? 'seek' : 'sync',
          data: {
              uri: newUri,
              position: newPosition,
              paused: newPaused,
              contextUri: newContextUri,
              shuffle: newShuffle
          },
          source: 'auto'
        });
      }
      this.updateSyncCache(newUri, newPaused, newPosition, newShuffle, newContextUri);
    } else if (newUri) {
        this.lastSyncedPosition = newPosition;
        this.lastCheckTime = now;
    }
    this.isFirstPoll = false;
  }

  async loadSavedPlaylists() {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/me/playlists?limit=50`));
      this.savedPlaylists$.next(res.items || []);
    } catch (err) {}
  }

  async loadRecentPlays() {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/me/player/recently-played?limit=12`));
      this.recentPlays$.next(res.items || []);
    } catch (err) {}
  }

  async loadQueue() {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/me/player/queue`));
      this.queue$.next(res.queue || []);
    } catch (err) {}
  }

  private loadPinned() {
    const pinned = JSON.parse(localStorage.getItem('spotify_pinned_items') || '[]');
    this.pinnedItems$.next(pinned);
  }

  togglePin(item: any) {
    const current = this.pinnedItems$.value;
    const isPinned = current.some(p => p.uri === item.uri);
    let updated;
    if (isPinned) {
      updated = current.filter(p => p.uri !== item.uri);
    } else {
      updated = [...current, {
        uri: item.uri,
        name: item.name || item.display_name,
        type: item.type,
        id: item.id || item.uri.split(':').pop(),
        image: item.images?.[0]?.url || item.image || 'assets/spotify-placeholder.png',
        owner: item.owner?.display_name || item.artist || item.owner || 'Unknown'
      }];
    }
    this.pinnedItems$.next(updated);
    localStorage.setItem('spotify_pinned_items', JSON.stringify(updated));
  }

  isPinned(uri: string): boolean {
    return this.pinnedItems$.value.some(p => p.uri === uri);
  }

  async killPlayer() {
    if (this.player) {
      try {
        await this.player.pause();
        this.player.disconnect();
      } catch (e) {
      } finally {
        this.player = null;
        this.sdkDeviceId = null;
        this.isReady$.next(false);
        this.currentTrack$.next(null);
        this.isPaused$.next(true);
      }
    }
  }

  private initSDK() {
    if (window.Spotify) {
      this.setupPlayer();
      return;
    }
    if (!document.getElementById('spotify-player-script')) {
      const script = document.createElement('script');
      script.id = 'spotify-player-script';
      script.src = 'https://sdk.scdn.co/spotify-player.js';
      script.async = true;
      document.body.appendChild(script);
    }
    window.onSpotifyWebPlaybackSDKReady = () => this.setupPlayer();
  }

  private setupPlayer() {
    if (this.player || !this.accessToken) return;
    this.player = new window.Spotify.Player({
      name: 'D&D Platform Player',
      getOAuthToken: (cb: any) => cb(this.accessToken),
      volume: 0.5
    });

    this.player.addListener('ready', ({ device_id }: any) => {
      this.sdkDeviceId = device_id;
      this.isReady$.next(true);
      this.getDevices().then(devices => {
        if (!devices.some(d => d.is_active)) {
          this.transferPlayback(device_id);
        }
      });
    });

    this.player.addListener('player_state_changed', (state: any) => {
      if (!state) return;
      const normalizedState = {
          paused: state.paused,
          position: state.position,
          track_window: state.track_window,
          context: state.context,
          shuffle_state: state.shuffle
      };
      this.checkAndEmitSync(normalizedState);
      this.currentTrack$.next(state.track_window.current_track);
      this.isPaused$.next(state.paused);
      this.shuffleState$.next(state.shuffle);
      this.loadQueue();
    });

    this.player.connect();
  }

  async getDevices(): Promise<SpotifyDevice[]> {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/me/player/devices`));
      return res.devices || [];
    } catch (err) {
      return [];
    }
  }

  async transferPlayback(deviceId: string, play: boolean = false) {
    try {
      await firstValueFrom(this.http.put(`${this.API_BASE}/me/player`, { device_ids: [deviceId], play }));
      this.activeDeviceId$.next(deviceId);
    } catch (err) {}
  }

  async search(query: string): Promise<SpotifySearchResult[]> {
    const params = new HttpParams().set('q', query).set('type', 'track,playlist,album,artist,show,episode').set('limit', '20');
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/search`, { params }));
      let results: SpotifySearchResult[] = [];
      if (res.tracks) {
        results = results.concat(res.tracks.items.filter((i:any) => i).map((i: any) => ({
          id: i.id, name: i.name, uri: i.uri, type: 'track', image: i.album?.images?.[0]?.url || '', artist: i.artists?.[0]?.name, artistId: i.artists?.[0]?.id
        })));
      }
      if (res.playlists) {
        results = results.concat(res.playlists.items.filter((i:any) => i).map((i: any) => ({
          id: i.id, name: i.name, uri: i.uri, type: 'playlist', image: i.images?.[0]?.url || '', owner: i.owner?.display_name, ownerId: i.owner?.id
        })));
      }
      if (res.albums) {
        results = results.concat(res.albums.items.filter((i:any) => i).map((i: any) => ({
          id: i.id, name: i.name, uri: i.uri, type: 'album', image: i.images?.[0]?.url || '', artist: i.artists?.[0]?.name, artistId: i.artists?.[0]?.id
        })));
      }
      if (res.artists) {
        results = results.concat(res.artists.items.filter((i:any) => i).map((i: any) => ({
          id: i.id, name: i.name, uri: i.uri, type: 'artist', image: i.images?.[0]?.url || ''
        })));
      }
      return results;
    } catch (err) {
      return [];
    }
  }

  async getUserPlaylists(userId: string): Promise<SpotifySearchResult[]> {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/users/${userId}/playlists?limit=20`));
      return (res.items || []).map((i: any) => ({
        id: i.id, name: i.name, uri: i.uri, type: 'playlist', image: i.images?.[0]?.url || '', owner: i.owner?.display_name, ownerId: i.owner?.id
      }));
    } catch (err) { return []; }
  }

  async getArtistAlbums(artistId: string): Promise<SpotifySearchResult[]> {
    try {
      const res: any = await firstValueFrom(this.http.get(`${this.API_BASE}/artists/${artistId}/albums?limit=20&include_groups=album,single`));
      return (res.items || []).map((i: any) => ({
        id: i.id, name: i.name, uri: i.uri, type: 'album', image: i.images?.[0]?.url || '', artist: i.artists?.[0]?.name, artistId: i.artists?.[0]?.id
      }));
    } catch (err) { return []; }
  }

  async getUser(userId: string): Promise<any> {
    try {
      return await firstValueFrom(this.http.get(`${this.API_BASE}/users/${userId}`));
    } catch (err) { return null; }
  }

  async getArtist(artistId: string): Promise<any> {
    try {
      return await firstValueFrom(this.http.get(`${this.API_BASE}/artists/${artistId}`));
    } catch (err) { return null; }
  }

  async play(uri?: string, positionMs: number = 0, skipSync: boolean = false, contextUri?: string): Promise<any> {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return null;

    if (!skipSync) this.lastActionTime = Date.now();

    let body: any = { position_ms: positionMs };
    if (contextUri) {
        body.context_uri = contextUri;
        if (uri && uri !== contextUri) body.offset = { uri: uri };
    } else if (uri) {
      if (uri.includes(':track:') || uri.includes(':episode:')) body.uris = [uri];
      else body.context_uri = uri;
    }

    try {
      const res = await firstValueFrom(this.http.put(`${this.API_BASE}/me/player/play?device_id=${targetId}`, body));
      setTimeout(() => this.loadQueue(), 1000);

      const effectiveUri = uri || this.currentTrack$.value?.uri;
      this.updateSyncCache(effectiveUri, false, positionMs, this.shuffleState$.value, contextUri || this.lastSyncedContextUri);

      if (!skipSync) {
        this.syncAction$.next({
          command: 'play',
          data: { uri: effectiveUri, position: positionMs, paused: false, contextUri: contextUri || (effectiveUri?.includes(':track:') ? undefined : effectiveUri), shuffle: this.shuffleState$.value },
          source: 'manual'
        });
      }
      return res;
    } catch (err) { return null; }
  }

  async addToQueue(uri: string): Promise<any> {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return null;
    try {
      const res = await firstValueFrom(this.http.post(`${this.API_BASE}/me/player/queue?uri=${encodeURIComponent(uri)}&device_id=${targetId}`, {}));
      setTimeout(() => this.loadQueue(), 1000);
      return res;
    } catch (err) { return null; }
  }

  async pause(skipSync: boolean = false) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    if (!skipSync) this.lastActionTime = Date.now();
    try {
        const res = await firstValueFrom(this.http.put(`${this.API_BASE}/me/player/pause?device_id=${targetId}`, {}));
        const state = await this.getPlaybackState();
        this.updateSyncCache(state?.track_window?.current_track?.uri || this.lastSyncedUri, true, state?.position || 0, state?.shuffle_state ?? this.lastSyncedShuffle, state?.context?.uri || this.lastSyncedContextUri);

        if (!skipSync) {
            this.syncAction$.next({
                command: 'pause',
                data: { uri: this.lastSyncedUri, position: this.lastSyncedPosition, paused: true, contextUri: this.lastSyncedContextUri, shuffle: this.lastSyncedShuffle },
                source: 'manual'
            });
        }
        return res;
    } catch (err) { return null; }
  }

  async seek(positionMs: number, skipSync: boolean = false) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    if (!skipSync) this.lastActionTime = Date.now();
    try {
      await firstValueFrom(this.http.put(`${this.API_BASE}/me/player/seek?position_ms=${positionMs}&device_id=${targetId}`, {}));
      this.lastSyncedPosition = positionMs;
      this.lastCheckTime = Date.now();
      if (!skipSync) {
        const state = await this.getPlaybackState();
        this.syncAction$.next({
          command: 'seek',
          data: { uri: state?.track_window?.current_track?.uri, position: positionMs, paused: state?.paused, contextUri: state?.context?.uri, shuffle: state?.shuffle_state ?? this.lastSyncedShuffle },
          source: 'manual'
        });
      }
    } catch (err) {}
  }

  async nextTrack(skipSync: boolean = false) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    if (!skipSync) this.lastActionTime = Date.now();
    try {
        const res = await firstValueFrom(this.http.post(`${this.API_BASE}/me/player/next?device_id=${targetId}`, {}));
        setTimeout(async () => {
            const state = await this.getPlaybackState();
            if (state) {
                this.updateSyncCache(state.track_window?.current_track?.uri, state.paused, state.position, state.shuffle_state, state.context?.uri);
                if (!skipSync) {
                    this.syncAction$.next({
                        command: 'next',
                        data: { uri: state.track_window?.current_track?.uri, position: 0, paused: false, contextUri: state.context?.uri, shuffle: state.shuffle_state },
                        source: 'manual'
                    });
                }
            }
        }, 1500);
        return res;
    } catch (err) { return null; }
  }

  async previousTrack(skipSync: boolean = false) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    if (!skipSync) this.lastActionTime = Date.now();
    try {
        const res = await firstValueFrom(this.http.post(`${this.API_BASE}/me/player/previous?device_id=${targetId}`, {}));
        setTimeout(async () => {
            const state = await this.getPlaybackState();
            if (state) {
                this.updateSyncCache(state.track_window?.current_track?.uri, state.paused, state.position, state.shuffle_state, state.context?.uri);
                if (!skipSync) {
                    this.syncAction$.next({
                        command: 'previous',
                        data: { uri: state.track_window?.current_track?.uri, position: 0, paused: false, contextUri: state.context?.uri, shuffle: state.shuffle_state },
                        source: 'manual'
                    });
                }
            }
        }, 1500);
        return res;
    } catch (err) { return null; }
  }

  async toggleShuffle(state: boolean, skipSync: boolean = false) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    if (!skipSync) this.lastActionTime = Date.now();
    try {
        await firstValueFrom(this.http.put(`${this.API_BASE}/me/player/shuffle?state=${state}&device_id=${targetId}`, {}));
        this.lastSyncedShuffle = state;
        this.shuffleState$.next(state);
        if (!skipSync) {
            const playback = await this.getPlaybackState();
            this.syncAction$.next({
              command: 'shuffle',
              data: { uri: playback?.track_window?.current_track?.uri, position: playback?.position || 0, paused: playback?.paused ?? true, contextUri: playback?.context?.uri, shuffle: state },
              source: 'manual'
            });
        }
    } catch (err) {}
  }

  async setVolume(v: number) {
    const targetId = this.activeDeviceId$.value || this.sdkDeviceId;
    if (!targetId) return;
    const volumePercent = Math.round(v * 100);
    return firstValueFrom(this.http.put(`${this.API_BASE}/me/player/volume?device_id=${targetId}&volume_percent=${volumePercent}`, {}));
  }

  async togglePlay(skipSync: boolean = false) {
    const state = await this.getPlaybackState();
    if (state && !state.paused) await this.pause(skipSync);
    else await this.play(undefined, state?.position || 0, skipSync);
  }

  async getPlaybackState() {
    if (this.activeDeviceId$.value === this.sdkDeviceId && this.player) {
      const state = await this.player.getCurrentState();
      if (state) return { paused: state.paused, position: state.position, shuffle_state: state.shuffle, track_window: state.track_window, context: state.context };
    }
    try {
      const state: any = await firstValueFrom(this.http.get(`${this.API_BASE}/me/player`));
      if (!state) return null;
      return {
        paused: !state.is_playing,
        position: state.progress_ms,
        shuffle_state: state.shuffle_state,
        track_window: { current_track: state.item ? { uri: state.item.uri, name: state.item.name, album: state.item.album, artists: state.item.artists } : null },
        context: state.context
      };
    } catch (e) { return null; }
  }

  login() {
    if (!this.accessToken) window.location.href = `${this.BACKEND_API}/spotify/login`;
    else this.initSDK();
  }
}
</file>

<file path="src/app/shared/services/vttsync/vttsync.ts">
import { Injectable } from '@angular/core';
import { io, Socket } from 'socket.io-client';
import {TokenService} from '../auth/token';
import {ICharacter} from '../../models/user/character.model';
import {VttEngine} from '../../modules/vttEngine/VttEngine';
import {Video} from '../video/video';
import {environment} from '../../../../environments/environment';
import { BehaviorSubject, firstValueFrom } from 'rxjs';
import { HttpClient } from '@angular/common/http';
import { FileService } from '../file/file';

export interface TurnOrderEntry {
  id: string;
  name: string;
  initiative: number;
  userId: string;
}

export interface TurnOrderState {
  isActive: boolean;
  isConfirmed: boolean;
  entries: TurnOrderEntry[];
  activeIndex: number;
}

export interface MapLibraryEntry {
  id: string;
  name: string;
  lastSaved: string;
  server: string;
  data: any;
  isArchived?: boolean;
}

export interface MapLoadingState {
  loading: boolean;
  progress: number;
  message: string;
}

@Injectable({ providedIn: 'root' })
export class VttSync {
  private socket: Socket | null = null;
  public currentRoomId: string | null = null;
  public isHosting = false;
  public isConnected = false;
  private engine: VttEngine| null = null;

  private localVersion = 0;
  private resyncing = false;

  public hostDisconnected$ = new BehaviorSubject<boolean>(false);
  public turnOrder$ = new BehaviorSubject<TurnOrderState>({
    isActive: false,
    isConfirmed: false,
    entries: [],
    activeIndex: 0
  });

  public mapLoading$ = new BehaviorSubject<MapLoadingState>({
    loading: false,
    progress: 0,
    message: ''
  });

  private readonly mapApiUrl = `${environment.apiURL}map`;

  constructor(
    private tokenService: TokenService,
    private callService: Video,
    private http: HttpClient,
    private fileService: FileService
  ) {
  }

  private getSocket(): Socket {
    if (!this.socket) {
      this.socket = io(`${environment.mapUrl}`, {
        path: '/map/',
        withCredentials: true,
        transports: ['websocket'],
        auth: (cb) => {
          cb({ token: this.tokenService.getAccessToken() })
        }
      });

      this.socket.on('connect', () => {
        this.isConnected = true;
      });

      this.socket.on('connect_error', (err) => {
        console.error('Socket Connection Error:', err.message);
        this.isConnected = false;
      });

      this.socket.on('host-disconnected', () => {
        console.warn('The DM has disconnected. You can assume hosting.');
        this.hostDisconnected$.next(true);
      });

      this.socket.on('host-changed', (payload: any) => {
        if (payload.hostId !== this.socket?.id) {
          this.hostDisconnected$.next(false);
          if (this.isHosting) {
            this.isHosting = false;
            if (this.engine) this.engine.setPermissions(false);
          }
        }
      });

      this.socket.on('disconnect', () => {
        this.isConnected = false;
      });

      this.socket.on('reconnect', () => {
        this.isConnected = true;
        if (this.currentRoomId) {
          this.requestResync();
        }
      });
    }
    return this.socket;
  }

  requestResync() {
    if (!this.currentRoomId || this.resyncing) return;
    console.log('Requesting resync for room:', this.currentRoomId);
    this.resyncing = true;
    this.getSocket().emit('request-resync', this.currentRoomId);
  }

  startHosting(engine: VttEngine, roomId: string) {
    this.currentRoomId = roomId;
    this.isHosting = true;
    this.engine = engine;

    const socket = this.getSocket();
    const isReattaching = socket.connected && this.currentRoomId === roomId;

    socket.emit('host-session', {
      roomId,
      initialState: isReattaching ? null : { ...engine.getRawConfig(), turnOrder: this.turnOrder$.value }
    });

    socket.off('remote-action');
    socket.on('remote-action', (payload: any) => {
      this.handleRemoteAction(engine, payload);
    });

    socket.off('map-update');
    socket.on('map-update', (config: any) => {
      this.resyncing = false;
      if (config.version !== undefined) {
        this.localVersion = config.version;
      }
      if (config.turnOrder) {
        this.turnOrder$.next(config.turnOrder);
      }
      if (isReattaching && engine.currentMapUrl) return;

      this.resolveUrlsInConfig(config);
      engine.loadConfigFromObject(config);
    });

    this.attachEngineListeners(engine);
    this.callService.sendVttCommand("start", roomId);
    this.hostDisconnected$.next(false);
  }

  joinSession(engine: VttEngine, roomId: string, character: ICharacter) {
    this.currentRoomId = roomId;
    this.isHosting = false;
    this.engine = engine;

    engine.setLocalCharacter(character);

    const socket = this.getSocket();
    const isReattaching = socket.connected && this.currentRoomId === roomId;

    socket.emit('join-session', { roomId, character });

    socket.off('map-update');
    socket.off('remote-action');
    socket.off('error');
    socket.off('session-ended');

    socket.on('map-update', (config: any) => {
      this.resyncing = false;
      if (config.version !== undefined) {
        this.localVersion = config.version;
      }
      if (config.turnOrder) {
        this.turnOrder$.next(config.turnOrder);
      }
      if (!isReattaching || !engine.currentMapUrl) {
        this.resolveUrlsInConfig(config);
        engine.loadConfigFromObject(config);
      }
    });

    socket.on('remote-action', (payload: any) => {
      this.handleRemoteAction(engine, payload);
    });

    socket.on('error', (msg: string) => {
      console.warn('VTT Sync Error:', msg);
    });

    socket.on('session-ended', () => {
      alert('The DM has ended the session.');
      this.stopSyncing(true);
    });

    this.attachEngineListeners(engine);
  }

  stopSyncing(force: boolean = false) {
    if (!force) return;

    if (this.socket && this.currentRoomId) {
      if (this.isHosting) {
        this.socket.emit('stop-hosting', this.currentRoomId);
      }

      // Explicitly tell the server we are leaving this room so it can calculate cleanup immediately
      this.socket.emit('leave-session', this.currentRoomId);

      this.socket.disconnect();
      this.socket = null;
    }

    this.currentRoomId = null;
    this.isHosting = false;
    this.isConnected = false;
    this.hostDisconnected$.next(false);
    this.engine = null;
    this.localVersion = 0;
    this.turnOrder$.next({ isActive: false, isConfirmed: false, entries: [], activeIndex: 0 });
  }

  broadcastAction(action: string, data: any) {
    const socket = this.getSocket();
    if (!socket.connected || !this.currentRoomId) return;
    socket.emit('sync-action', {
      roomId: this.currentRoomId,
      action,
      data
    });
  }

  private attachEngineListeners(engine: VttEngine) {
    engine.stage.off('tokenMoved');
    engine.stage.on('tokenMoved', (e: any) => {
      this.broadcastAction('token-move', e);
    });

    engine.stage.off('measureAction');
    engine.stage.on('measureAction', (data: any) => {
      this.broadcastAction('measure-sync', data);
    });

    engine.stage.off('ping');
    engine.stage.on('ping', (data: any) => {
      this.broadcastAction('ping', data);
    });

    engine.stage.off('mapLoadingStarted');
    engine.stage.on('mapLoadingStarted', () => {
      this.mapLoading$.next({ loading: true, progress: 0, message: 'Processing map image...' });
    });

    engine.stage.off('mapLoadingFinished');
    engine.stage.on('mapLoadingFinished', () => {
      this.mapLoading$.next({ loading: false, progress: 0, message: '' });
    });

    engine.stage.off('tokenAdded');
    engine.stage.on('tokenAdded', (data: any) => {
      if (!data.remote) this.broadcastAction('token-added', data);
    });

    engine.stage.off('tokenDeleted');
    engine.stage.on('tokenDeleted', (data: any) => {
      if (!data.remote) this.broadcastAction('token-deleted', data);
    });

    engine.stage.off('tokenUpdated');
    engine.stage.on('tokenUpdated', (data: any) => {
      if (!data.remote) this.broadcastAction('token-update', data);
    });

    if (this.isHosting) {
      engine.stage.off('wallAdded');
      engine.stage.on('wallAdded', (data: any) => {
        this.broadcastAction('wall-added', data);
      });

      engine.stage.off('wallDeleted');
      engine.stage.on('wallDeleted', (data: any) => {
        this.broadcastAction('wall-deleted', data);
      });

      engine.stage.off('lightingToggled');
      engine.stage.on('lightingToggled', (data: any) => {
        this.broadcastAction('lighting-toggle', data);
      });

      engine.stage.off('gridSizeChanged');
      engine.stage.on('gridSizeChanged', (data: any) => {
        this.broadcastAction('grid-size-change', data);
      });
    }
  }


  private handleRemoteAction(engine: VttEngine, { action, data, version }: any) {
    if (version !== undefined) {
      if (version > this.localVersion + 1) {
        console.warn(`Out of sync! Local: ${this.localVersion}, Remote: ${version}. Requesting resync.`);
        this.requestResync();
        return;
      }
      this.localVersion = version;
    }

    switch (action) {
      case 'token-move':
        engine.animateTokenMove(data.id, data.x, data.y);
        break;

      case 'wall-added':
        engine.wallManager.addSingleWall(data.points);
        break;

      case 'wall-deleted':
        engine.wallManager.deleteWallByPoints(data.points);
        break;


      case 'token-added':
        if (data.options && data.options.icon) {
          data.options.icon = this.fileService.resolveFileUrl(data.options.icon);
        }
        engine.addToken(data.x, data.y, data.options, true);
        break;

      case 'token-deleted':
        engine.removeToken(data.id, true);
        break;

      case 'token-update':
        if (data.options && data.options.icon) {
          data.options.icon = this.fileService.resolveFileUrl(data.options.icon);
        }
        engine.updateTokenConfig(data.id, data.options, true);
        break;

      case 'lighting-toggle':
        engine.lightLayer.visible(data.visible);
        engine.updateLighting();
        break;

      case 'grid-size-change':
        engine.updateGridSize(data.size, true);
        break;

      case 'map-change':
        engine.setBackground(this.fileService.resolveFileUrl(data.url), true);
        break;

      case 'map-load':
        this.resolveUrlsInConfig(data);
        engine.loadConfigFromObject(data);
        if (data.turnOrder) {
          this.turnOrder$.next(data.turnOrder);
        }
        break;

      case 'measure-sync':
        if (engine.measurementManager) {
          engine.measurementManager.handleRemoteAction(data);
        }
        break;

      case 'ping':
        engine.showPing(data.x, data.y, data.color);
        break;

      case 'turn-order-sync':
        this.turnOrder$.next(data);
        break;

      case 'turn-order-add':
        if (this.isHosting) this.addTurnOrderEntry(data);
        break;

      case 'turn-order-remove':
        if (this.isHosting) this.removeTurnOrderEntry(data.id);
        break;
    }
    engine.stage.batchDraw();
  }

  private resolveUrlsInConfig(config: any): any {
    if (!config) return config;
    if (config.mapUrl) {
      config.mapUrl = this.fileService.resolveFileUrl(config.mapUrl);
    }
    if (config.tokens && Array.isArray(config.tokens)) {
      config.tokens.forEach((t: any) => {
        if (t.icon) {
          t.icon = this.fileService.resolveFileUrl(t.icon);
        }
      });
    }
    return config;
  }

  addCharacterToken(engine: VttEngine, character: ICharacter, x?: number, y?: number) {
    const posX = x ?? 100;
    const posY = y ?? 100;

    const tokenOptions = {
      id: crypto.randomUUID(),
      name: character.name,
      icon: character.icon ? this.fileService.resolveFileUrl(character.icon) : null,
      ownerId: character.ownerId,
      isPlayer: true
    };

    engine.addToken(posX, posY, tokenOptions, false);
  }

  async setMap(mapSource: File | string, onProgress?: (progress: number) => void): Promise<void> {
    if (!this.engine) {
      console.error('VttEngine not initialized.');
      return;
    }

    let mapUrl: string;

    if (typeof mapSource === 'string') {
      mapUrl = this.fileService.resolveFileUrl(mapSource);
    } else {
      if (!this.isHosting) {
        console.warn('Only the host can upload new map images directly.');
        return;
      }
      try {
        this.mapLoading$.next({ loading: true, progress: 0, message: 'Uploading map...' });
        const uploadedFile = await this.fileService.uploadFileInChunks(mapSource, (progress) => {
          this.mapLoading$.next({ loading: true, progress, message: `Uploading map (${progress}%)...` });
          if (onProgress) onProgress(progress);
        });
        mapUrl = uploadedFile.url;
      } catch (error) {
        this.mapLoading$.next({ loading: false, progress: 0, message: '' });
        console.error('Failed to upload map image:', error);
        throw error;
      }
    }

    this.engine.setBackground(mapUrl, false);

    if (this.isHosting) {
      this.broadcastAction('map-change', { url: mapUrl });
    }
  }

  async updateToken(tokenId: string, options: any, iconFile?: File): Promise<void> {
    if (!this.engine) return;

    if (iconFile) {
      try {
        this.mapLoading$.next({ loading: true, progress: 0, message: 'Uploading token icon...' });
        const uploadedFile = await this.fileService.uploadFileInChunks(iconFile, (progress) => {
          this.mapLoading$.next({ loading: true, progress, message: `Uploading icon (${progress}%)...` });
        });
        options.icon = uploadedFile.url;
      } catch (error) {
        this.mapLoading$.next({ loading: false, progress: 0, message: '' });
        console.error('Failed to upload token icon:', error);
        return;
      }
    } else if (options.icon) {
      options.icon = this.fileService.resolveFileUrl(options.icon);
    }

    this.engine.updateTokenConfig(tokenId, options, false);
    this.mapLoading$.next({ loading: false, progress: 0, message: '' });
  }

  public updateTurnOrder(state: TurnOrderState) {
    this.turnOrder$.next(state);
    if (this.isHosting) {
      this.broadcastAction('turn-order-sync', state);
    }
  }

  public activateTurnOrder() {
    this.updateTurnOrder({
      isActive: true,
      isConfirmed: false,
      entries: [],
      activeIndex: 0
    });
  }

  public endTurnOrder() {
    this.updateTurnOrder({
      isActive: false,
      isConfirmed: false,
      entries: [],
      activeIndex: 0
    });
  }

  public confirmTurnOrder() {
    const currentState = this.turnOrder$.value;
    const sortedEntries = [...currentState.entries].sort((a, b) => b.initiative - a.initiative);
    this.updateTurnOrder({
      ...currentState,
      isConfirmed: true,
      entries: sortedEntries,
      activeIndex: 0
    });
  }

  public nextTurn() {
    const currentState = this.turnOrder$.value;
    if (!currentState.entries.length) return;
    const nextIndex = (currentState.activeIndex + 1) % currentState.entries.length;
    this.updateTurnOrder({
      ...currentState,
      activeIndex: nextIndex
    });
  }

  public prevTurn() {
    const currentState = this.turnOrder$.value;
    if (!currentState.entries.length) return;
    const prevIndex = (currentState.activeIndex - 1 + currentState.entries.length) % currentState.entries.length;
    this.updateTurnOrder({
      ...currentState,
      activeIndex: prevIndex
    });
  }

  public addTurnOrderEntry(entry: TurnOrderEntry) {
    if (this.isHosting || !this.getSocket().connected) {
      const currentState = this.turnOrder$.value;
      const newEntries = [...currentState.entries, entry];
      if (currentState.isConfirmed) {
        newEntries.sort((a, b) => b.initiative - a.initiative);
      }
      this.updateTurnOrder({ ...currentState, entries: newEntries });
    } else {
      this.broadcastAction('turn-order-add', entry);
    }
  }

  public removeTurnOrderEntry(entryId: string) {
    if (this.isHosting || !this.getSocket().connected) {
      const currentState = this.turnOrder$.value;
      this.updateTurnOrder({
        ...currentState,
        entries: currentState.entries.filter(e => e.id !== entryId)
      });
    } else {
      this.broadcastAction('turn-order-remove', { id: entryId });
    }
  }

  getEngine() {
    return this.engine;
  }

  async saveMapLibrary(library: MapLibraryEntry[]): Promise<void> {
    await firstValueFrom(this.http.post(`${this.mapApiUrl}/library`, { library }, { withCredentials: true }));
  }

  async loadMapLibrary(): Promise<MapLibraryEntry[]> {
    try {
      const library = await firstValueFrom(this.http.get<MapLibraryEntry[]>(`${this.mapApiUrl}/library`, { withCredentials: true }));
      return library.map(entry => {
        if (entry.data) {
          this.resolveUrlsInConfig(entry.data);
        }
        return entry;
      });
    } catch (e) {
      console.error('Failed to load map library', e);
      return [];
    }
  }

  async saveMap(map: MapLibraryEntry): Promise<void> {
    await firstValueFrom(this.http.post(`${this.mapApiUrl}/save`, map, { withCredentials: true }));
  }

  async deleteMap(mapId: string): Promise<void> {
    await firstValueFrom(this.http.delete(`${this.mapApiUrl}/${mapId}`, { withCredentials: true }));
  }
}
</file>

