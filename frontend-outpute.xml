  padding: 16px 20px;
  background: rgba(0,0,0,0.4);
  border-bottom: 1px solid var(--spotify-light-grey);
  z-index: 10;

  .title-with-icon {
    display: flex;
    align-items: center;
    gap: 10px;
    h3 {
      margin: 0;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .spotify-icon { color: var(--spotify-green); }
  }

  .header-actions {
     display: flex;
     gap: 8px;
     align-items: center;

     button {
       background: none;
       border: none;
       color: var(--spotify-text-muted);
       cursor: pointer;
       padding: 6px;
       border-radius: var(--radius-round);
       display: flex;
       align-items: center;
       justify-content: center;
       transition: all var(--transition-standard);

       &:hover {
         color: white;
         background: var(--surface-light);
       }
       &.active { color: var(--spotify-green); }
       &.close-btn { font-size: 20px; line-height: 1; }
     }
