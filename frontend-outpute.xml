import {AfterViewInit, ChangeDetectorRef, Component, EventEmitter, Output} from '@angular/core';

import {ICharacter} from '../../../shared/models/user/character.model';

import {CharacterService} from '../../../shared/services/character/character';
import {CommonModule} from '@angular/common';
import {MatSelectModule} from '@angular/material/select';
import {MatFormFieldModule} from '@angular/material/form-field';
import {MatListModule} from '@angular/material/list';
import {MatIconModule} from '@angular/material/icon';
import {MatButtonModule} from '@angular/material/button';
import {MatDividerModule} from '@angular/material/divider';
import {Router} from '@angular/router';
import {MatMenuModule} from '@angular/material/menu';
import {UserService} from '../../../shared/services/user/user';
import {ServerService} from '../../../shared/services/server/server';
import {IServer} from '../../../shared/models/server/server.model';
import {ChannelType, IChannel} from '../../../shared/models/server/channel.model';
import {ChannelService} from '../../../shared/services/channel/channel';
import {TabService} from '../../../shared/services/tab/tab-service';
import {MatDialog} from '@angular/material/dialog';
import {
  ServerSettingsDialogComponent
} from '../../../objects/server-settings-dialog-component/server-settings-dialog-component';
import {ServerAddDialogComponent} from '../../../objects/server-add-dialog-component/server-add-dialog-component';
import {VttSync} from '../../../shared/services/vttsync/vttsync';
import {ObsidianVaultService} from '../../../shared/services/ObsidianVault/obsidian-vault-service';


@Component({

  selector: 'app-side-panel',

  imports: [CommonModule,
    MatSelectModule,
    MatFormFieldModule,
    MatListModule,
    MatIconModule,
    MatButtonModule,
    MatDividerModule,
    MatMenuModule,
  ],

  templateUrl: './side-panel.html',
  styleUrl: './side-panel.scss',

})

export class SidePanel implements AfterViewInit {

  @Output() whisperInitiated = new EventEmitter<any>();

  characters: ICharacter[] = [];
  selectedCharacter: ICharacter | null = null;

  servers: IServer[] = [];
  selectedServer: IServer | null = null;
  channels: IChannel[] = [];

  groupedMembers: any[] = [];

  currentUserId: string | null = null;
  private isFirstLoad = true;


  constructor(
    private cdr: ChangeDetectorRef,
    private charService: CharacterService,
    private tabService: TabService,
    private userService: UserService,
    private serverService: ServerService,
    public channelService: ChannelService,
    private router: Router,
    private dialog: MatDialog,
    private vttSync: VttSync,
    public obsidianService: ObsidianVaultService
  ) {
  }


  ngAfterViewInit(): void {


    this.userService.getMe().subscribe((user) => {
      this.currentUserId = user._id;
      this.charService.getMyCharacters().subscribe((chars) => {
        this.characters = chars;
        let userChar = ({
          ac: 0,
          baseStats: {
            strength: 0,
            dexterity: 0,
            constitution: 0,
            intelligence: 0,
            wisdom: 0,
            charisma: 0
          },
          classes: [],
          ownerId: user._id,
          race: 'Human? Maybe...',
          servers: ['0'],
          name: user.username, icon: user.profileIcon || null
        })
        this.characters = [
          userChar,
          ...this.characters
        ]

        this.onCharacterChange(this.characters[0]);
        this.cdr.markForCheck();
      });


    });


    this.serverService.getMyServersObservable().subscribe((servers) => {

      if (servers.length > 0) {
        this.servers = servers;
        const savedServerId = this.serverService.getSelectedServerId();
        const serverToSelect = servers.find(s => s._id === savedServerId) || servers[0];

        if (this.isFirstLoad) {
           this.selectServer(serverToSelect, false);
           this.isFirstLoad = false;
        }


      }
    })


    this.serverService.getServerDetailsObservable().subscribe((server) => {
      if (server) {
        this.selectedServer = server

        if (server && this.currentUserId && server.channels) {
          // Filter out whisper channels from the main channels list
          this.channels = server.channels.filter(c => c.type !== ChannelType.Whisper);

          if (this.channels[0]) this.selectChannel(this.channels[0]);

          // Only show if user is owner AND a vault is linked
          if (this.obsidianService.isOwner(server, this.currentUserId) &&
            this.obsidianService.hasVaultAttached(server._id)) {
            this.channels.push(this.obsidianService.getObsidianChannel(server._id));
          }


          this.groupMembersByRole(server);

          // --- Debugging logs for Obsidian buttons ---
          console.log('--- Obsidian Button Debugging ---');
          console.log('selectedServer:', this.selectedServer);
          console.log('currentUserId:', this.currentUserId);
          console.log('selectedServer.owner:', (this.selectedServer as any)?.owner);
          console.log('Is current user owner:', this.isServerOwner);
          console.log('hasVaultAttached:', this.obsidianService.hasVaultAttached((this.selectedServer as any)?._id));
          console.log('--- End Debugging ---');
          // --- End Debugging logs ---
        }

      }


    })
    this.serverService.getMyServers();

  }


  onCharacterChange(char: ICharacter) {
    this.selectedCharacter = char;
    this.charService.setActiveCharacter(this.selectedCharacter);

  }


  goToManageCharacters() {
    this.router.navigate(['characters']);

  }

  selectChannel(channel: IChannel) {
    this.channelService.setChannelObservable(channel);
  }

  openObsidian(){
    console.log("open Obsidian")
    if(!this.selectedServer) return
    let obsidianChannel = this.obsidianService.getObsidianChannel(this.selectedServer._id);

    console.log(obsidianChannel, "opening")
    this.selectChannel(obsidianChannel)
  }


  selectServer(server: any, clearTabs = true) {

    if (clearTabs) {
      this.tabService.closeAllTabs()
    }
    this.serverService.getServerDetails(server._id);

    this.cdr.markForCheck();

    // --- Debugging logs for Obsidian buttons ---
    console.log('--- Obsidian Button Debugging (selectServer) ---');
    console.log('selectedServer:', this.selectedServer);
    console.log('currentUserId:', this.currentUserId);
    console.log('selectedServer.owner:', (this.selectedServer as any)?.owner);
    console.log('Is current user owner:', this.isServerOwner);
    console.log('hasVaultAttached:', this.obsidianService.hasVaultAttached((this.selectedServer as any)?._id));
    console.log('--- End Debugging (selectServer) ---');
    // --- End Debugging logs ---
  }

  getServerColor(name: string): string {
    const colors = ['#5865F2', '#3BA55D', '#ED4245', '#FAA61A', '#EB459E', '#7289DA'];
    let hash = 0;
    for (let i = 0; i < name.length; i++) {
      hash = name.charCodeAt(i) + ((hash << 5) - hash);
    }
    return colors[Math.abs(hash) % colors.length];
  }

  get isServerOwner(){
    return (this.selectedServer?.owner as any) === this.currentUserId;
  }


  openSettings() {
    this.dialog.open(ServerSettingsDialogComponent, {
      data: this.selectedServer,
      width: '1800px',
      maxWidth: '95vw',
      height: '80vh',
      panelClass: 'server-settings-dialog'
    });
  }

  openAddServerDialog() {
    this.dialog.open(ServerAddDialogComponent, {
      width: '50vw',
      height: '70vh',
      minWidth: '400px',
      minHeight: '500px',
      panelClass: 'custom-dialog-container'
    });
  }

  async linkObsidian() {
    if (this.selectedServer) {
      await this.obsidianService.attachVaultToServer(this.selectedServer._id);
      // Trigger a refresh of server details to show the new channel
      this.serverService.getServerDetails(this.selectedServer._id);
    }
  }

  linkObsidianLocalhost() {
    if (this.selectedServer) {
      const url = prompt('Enter the localhost URL for your Obsidian vault (e.g., http://localhost:27124):');
      if (url) {
        this.obsidianService.setVaultLocalhostRoute(this.selectedServer._id, url);
        // Trigger a refresh of server details to show the new channel
        this.serverService.getServerDetails(this.selectedServer._id);
      }
    }
  }

  groupMembersByRole(server: any) {

    if (!server || !server.roles || !server.members) {
      this.groupedMembers = [];
      return;
    }

    const hoistedRoles = server.roles
      .filter((r: any) => r?.hoist)
      .sort((a: any, b: any) => (b.position || 0) - (a.position || 0));

    const groups: any[] = [];

    // Groups for hoisted roles
    hoistedRoles.forEach((role: any) => {

      const members = server.members.filter((member: any) =>
        member?.roles?.some((r: any) => r._id === role._id)
      );

      if (members.length) {
        groups.push({
          role,
          members
        });
      }
    });

    // Members without hoisted roles
    const ungrouped = server.members.filter((member: any) =>
      !member?.roles?.some((r: any) =>
        hoistedRoles.some((hr: any) => hr._id === r._id)
      )
    );

    if (ungrouped.length) {
      groups.push({
        role: {name: "Members"},
        members: ungrouped
      });
    }

    this.groupedMembers = groups;
  }

  openCharacter(character: ICharacter) {
    if (character?._id) {
      this.tabService.openTab(character._id, character.name, 'character', 'right', character);
    }
  }

  openVTT() {
    if (!this.selectedServer?._id) return;
    this.tabService.openTab(this.selectedServer?._id, "vtt", "vtt", "left");
  }

  onRightClickCharacter(event: MouseEvent, character: ICharacter) {
    event.preventDefault(); // Prevent browser context menu

    // 1. Check if we are actually in a VTT session
    if (!this.vttSync.isConnected) {
      console.warn('Cannot add token: No active VTT session.');
      return;
    }

    // 2. Obtain the engine instance.
    // If your engine is stored in a shared service or accessible via a getter:
    const engine = this.vttSync.getEngine();

    if (engine) {
      // 3. Call the service method we built earlier
      this.vttSync.addCharacterToken(engine, character);
      console.log(`Added ${character.name} to the map via right-click.`);
    } else {
      console.error('VTT Engine not found. Is the map tab open?');
    }
  }

  whisperUser(recipientId: string | any) {
    if (!this.selectedServer || !recipientId) return;
    const rId = typeof recipientId === 'string' ? recipientId : recipientId?._id;
    if (!rId) return;

    this.serverService.getOrCreateWhisperChannel(this.selectedServer._id, rId).subscribe(channel => {
        if (channel._id) {
          this.channelService.setChannelObservable(channel);
          this.tabService.openTab(channel._id, channel.name, 'whisper');
        }
    });
  }


}
</file>

<file path="src/app/pages/dashboard/call/call.html">
<div class="video-container">

  <!-- PRE-JOIN SCREEN -->
  @if (!localStream) {
    <div class="pre-join-screen">
      <div class="setup-card glass">
        <div class="preview-area">
          <video #previewVideo autoplay playsinline [muted]="true" [class.video-hidden]="isPreviewVideoOff"></video>
          <div class="preview-placeholder" *ngIf="isPreviewVideoOff">
            <mat-icon>videocam_off</mat-icon>
            <span>Video is Off</span>
          </div>

          <div class="preview-controls">
            <button class="btn-setup" (click)="toggleAudio()" [class.active]="isPreviewMuted">
              <mat-icon>{{ isPreviewMuted ? 'mic_off' : 'mic' }}</mat-icon>
            </button>
            <button class="btn-setup" (click)="toggleVideo()" [class.active]="isPreviewVideoOff">
              <mat-icon>{{ isPreviewVideoOff ? 'videocam_off' : 'videocam' }}</mat-icon>
            </button>
          </div>
        </div>

        <div class="setup-content">
          <h2>Ready to join?</h2>
          <p>Configure your devices before entering the call.</p>

          <!-- Spotify Authorization Prompt -->
          <div class="spotify-auth-prompt" [class.connected]="(spotify.isAuthorized$ | async)">
            <div class="spotify-status">
              <div class="spotify-icon-bg">
                <mat-icon>music_note</mat-icon>
              </div>
              <div class="status-text">
                <strong>Spotify Sync</strong>
                <span>{{ (spotify.isAuthorized$ | async) ? 'Account connected' : 'Connect to sync music with others' }}</span>
              </div>
            </div>
            @if (!(spotify.isAuthorized$ | async)) {
              <button class="btn-spotify-login" (click)="spotify.login()">
                <mat-icon>login</mat-icon>
                <span>Connect Spotify</span>
              </button>
            } @else {
              <div class="connected-badge">
                <mat-icon>check_circle</mat-icon>
                <span>Ready</span>
              </div>
            }
          </div>

          <div class="settings-grid">
            <div class="device-select">
              <mat-icon>videocam</mat-icon>
              <select [(ngModel)]="selectedVideoId" (change)="onDeviceChange()">
                <option *ngFor="let d of videoDevices" [value]="d.deviceId">{{ d.label }}</option>
              </select>
            </div>
            <div class="device-select">
              <mat-icon>mic</mat-icon>
              <select [(ngModel)]="selectedAudioId" (change)="onDeviceChange()">
                <option *ngFor="let d of audioDevices" [value]="d.deviceId">{{ d.label }}</option>
              </select>
            </div>
          </div>

          <button class="btn-primary-join" (click)="joinCall()">
            <mat-icon>login</mat-icon>
            <span>Enter Call</span>
          </button>
        </div>
      </div>
    </div>
  }

  <!-- ACTIVE CALL VIEW -->
  @if (localStream) {
    <div #gridContainer class="grid count-{{ remoteStreams.length + 1 }}">
      <!-- Local Video -->
      <div class="video-box local" [class.video-hidden]="isVideoOff">
        <video #localVideo autoplay playsinline [muted]="true"></video>
        <div class="video-placeholder" *ngIf="isVideoOff">
          <div class="user-avatar">{{ (isDmMode ? dmCharacter : character).name?.charAt(0) || 'Y' }}</div>
        </div>

        <!-- RPG Unit Frame Overlay -->
        <div class="character-overlay">

          <!-- Stats Hover Card (Glass) -->
          <div class="character-hover-card glass">
            <div class="hover-header">
              <strong>{{ (isDmMode ? dmCharacter : character).name }}</strong>
              <span>{{ (isDmMode ? dmCharacter : character).race }}</span>
            </div>
            <div class="hover-section">
              @for (c of (isDmMode ? dmCharacter : character).classes; track c) {
                <div class="class-line">Lvl {{ c.level }} {{ c.className }}</div>
              }
            </div>
            <div class="hover-stats">
              <div class="stat-pill"><span>STR</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.strength }}</strong></div>
              <div class="stat-pill"><span>DEX</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.dexterity }}</strong></div>
              <div class="stat-pill"><span>CON</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.constitution }}</strong></div>
              <div class="stat-pill"><span>INT</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.intelligence }}</strong></div>
              <div class="stat-pill"><span>WIS</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.wisdom }}</strong></div>
              <div class="stat-pill"><span>CHA</span><strong>{{ (isDmMode ? dmCharacter : character).baseStats.charisma }}</strong></div>
            </div>
            <div class="hover-footer" *ngIf="(isDmMode ? dmCharacter : character).ac">
              <mat-icon>shield</mat-icon>
              <span>Armor Class: {{ (isDmMode ? dmCharacter : character).ac }}</span>
            </div>
          </div>

          <!-- The RPG Unit Frame (Bottom Left) -->
          <div class="unit-frame">
            <div class="portrait-container">
              <div class="portrait-inner">
                <ng-container *ngIf="isDmMode">
                  <div class="dm-portrait">
                    <mat-icon>dvr</mat-icon>
                  </div>
                </ng-container>
                <ng-container *ngIf="!isDmMode">
                  <img [src]="character.icon || 'https://www.gravatar.com/avatar/'+character._id+'?d=identicon'" class="char-portrait">
                </ng-container>
              </div>
              <div class="level-badge" *ngIf="(isDmMode ? dmCharacter : character).classes?.length">
                {{ (isDmMode ? dmCharacter : character).classes[0].level }}
              </div>
            </div>

            <div class="unit-info">
              <div class="name-row">
                <span class="char-name">{{ (isDmMode ? dmCharacter : character).name || 'You' }}</span>
                @if (isAudioMuted) {
                  <mat-icon class="mute-icon">mic_off</mat-icon>
                }
              </div>
              <div class="sub-row">
                <span class="char-race">{{ (isDmMode ? dmCharacter : character).race }}</span>
              </div>
              <!-- Decorative bars for RPG feel -->
              <div class="status-bars">
                <div class="bar hp"></div>
                <div class="bar resource"></div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Remote Videos -->
      <div class="video-box remote" *ngFor="let remote of remoteStreams" (click)="openCharacter(remote.userData)">
        <video #remoteVideo autoplay playsinline></video>

        @if (remote.userData){
          <div class="character-overlay">

            <!-- Remote Stats Hover -->
            <div class="character-hover-card glass">
              <div class="hover-header">
                <strong>{{ remote.userData.name }}</strong>
                <span>{{ remote.userData.race }}</span>
              </div>
              <div class="hover-section">
                @for (c of remote.userData.classes; track c) {
                  <div class="class-line">Lvl {{ c.level }} {{ c.className }}</div>
                }
              </div>
              <div class="hover-stats" *ngIf="remote.userData.baseStats">
                <div class="stat-pill"><span>STR</span><strong>{{ remote.userData.baseStats.strength }}</strong></div>
                <div class="stat-pill"><span>DEX</span><strong>{{ remote.userData.baseStats.dexterity }}</strong></div>
                <div class="stat-pill"><span>CON</span><strong>{{ remote.userData.baseStats.constitution }}</strong></div>
                <div class="stat-pill"><span>INT</span><strong>{{ remote.userData.baseStats.intelligence }}</strong></div>
                <div class="stat-pill"><span>WIS</span><strong>{{ remote.userData.baseStats.wisdom }}</strong></div>
                <div class="stat-pill"><span>CHA</span><strong>{{ remote.userData.baseStats.charisma }}</strong></div>
              </div>
              <div class="hover-footer" *ngIf="remote.userData.ac">
                <mat-icon>shield</mat-icon>
                <span>Armor Class: {{ remote.userData.ac }}</span>
              </div>
            </div>

            <!-- Remote RPG Unit Frame -->
            <div class="unit-frame">
              <div class="portrait-container">
                <div class="portrait-inner">
                  <ng-container *ngIf="remote.userData.name === 'DM'">
                      <div class="dm-portrait">
                        <mat-icon>dvr</mat-icon>
                      </div>
                  </ng-container>
                  <ng-container *ngIf="remote.userData.name !== 'DM'">
                    <img [src]="remote.userData.icon || 'https://www.gravatar.com/avatar/'+remote.userData._id+'?d=identicon'" class="char-portrait">
                  </ng-container>
                </div>
                <div class="level-badge" *ngIf="remote.userData.classes?.length">
                  {{ remote.userData.classes[0].level }}
                </div>
              </div>

              <div class="unit-info">
                <div class="name-row">
                  <span class="char-name">{{ remote.userData.name || 'Unnamed' }}</span>
                </div>
                <div class="sub-row">
                  <span class="char-race">{{ remote.userData.race }}</span>
                </div>
                <div class="status-bars">
                  <div class="bar hp"></div>
                  <div class="bar resource"></div>
                </div>
              </div>
            </div>

          </div>
        }
      </div>
    </div>

    <!-- Bottom Toolbar -->
    <div class="bottom-toolbar">
      <div class="controls-wrapper">
        <div class="media-actions">
          <button (click)="showSpotify = !showSpotify" class="btn-action btn-spotify" [class.active]="showSpotify" matTooltip="Spotify">
            <mat-icon>music_note</mat-icon>
          </button>

          <button *ngIf="isServerOwner && spotifyRequests.length > 0" (click)="showSpotifyRequests = !showSpotifyRequests" class="btn-action btn-requests" [class.active]="showSpotifyRequests" matTooltip="Song Requests">
            <mat-icon [class.pulse]="spotifyRequests.length > 0">playlist_add_check</mat-icon>
            <span class="badge">{{ spotifyRequests.length }}</span>
          </button>

          <button (click)="toggleAudio()" [class.active]="isAudioMuted" class="btn-action" [matTooltip]="isAudioMuted ? 'Unmute' : 'Mute'">
            <mat-icon>{{ isAudioMuted ? 'mic_off' : 'mic' }}</mat-icon>
          </button>
          <button (click)="toggleVideo()" [class.active]="isVideoOff" class="btn-action" [matTooltip]="isVideoOff ? 'Start Video' : 'Stop Video'">
            <mat-icon>{{ isVideoOff ? 'videocam_off' : 'videocam' }}</mat-icon>
          </button>

          <!-- DM Mode Toggle -->
          <button *ngIf="isServerOwner" (click)="toggleDmMode()" class="btn-action btn-dm" [class.active]="isDmMode" matTooltip="DM Mode">
            <mat-icon>dvr</mat-icon>
          </button>

          <button *ngIf="vttSession.active && vttSession.hostId !== (isDmMode ? dmCharacter : character).name" (click)="startVttJoining()" class="btn-action" matTooltip="Join VTT">
            <mat-icon>group_add</mat-icon>
          </button>

          <!-- Custom Theme Picker Toggle -->
          <button (click)="showThemePicker = !showThemePicker" class="btn-action" [class.active]="showThemePicker" matTooltip="Atmosphere Settings">
            <mat-icon>palette</mat-icon>
          </button>

          <button (click)="leaveCall()" class="btn-action btn-danger" matTooltip="Leave Call">
            <mat-icon>call_end</mat-icon>
          </button>
        </div>
      </div>
    </div>

    <!-- Theme Picker Custom Overlay -->
    <div class="theme-picker-overlay glass" *ngIf="showThemePicker">
        <div class="overlay-header">
            <h3>Atmosphere</h3>
            <button class="btn-close" (click)="showThemePicker = false">
                <mat-icon>close</mat-icon>
            </button>
        </div>

        <div class="theme-scroll-area" (click)="$event.stopPropagation()">
          @for (t of availableThemes; track t.id) {
            <div class="theme-item"
                 (click)="syncTheme(t.id)"
                 (mouseenter)="previewTheme(t.id)"
                 (mouseleave)="clearThemePreview()">
              <div class="theme-swatch" [class.active]="activeThemeSession === t.id">
                  <div class="swatch-split primary" [style.background]="t.primary"></div>
                  <div class="swatch-split secondary" [style.background]="t.secondary"></div>
                  <mat-icon *ngIf="activeThemeSession === t.id">check</mat-icon>
              </div>
              <span class="theme-label">{{ t.name }}</span>
            </div>
          }
        </div>
    </div>
  }

  <!-- Spotify Overlay -->
  <div class="spotify-overlay" *ngIf="showSpotify && localStream">
    <app-spotify-player
      [isCallActive]="!!localStream"
      [isServerOwner]="isServerOwner"
      [userName]="character.name"
      (close)="showSpotify = false">
    </app-spotify-player>
  </div>

  <!-- Spotify Requests Overlay -->
  <div class="spotify-requests-overlay glass" *ngIf="showSpotifyRequests && isServerOwner">
    <div class="overlay-header">
      <h3>Song Requests</h3>
      <button class="btn-close" (click)="showSpotifyRequests = false">
        <mat-icon>close</mat-icon>
      </button>
    </div>
    <div class="requests-list">
      <div *ngFor="let req of spotifyRequests" class="request-item">
        <img [src]="req.image || 'assets/spotify-placeholder.png'" class="req-thumb">
        <div class="req-details">
          <div class="req-name">{{ req.name }}</div>
          <div class="req-meta">{{ req.artist }} • Requested by <strong>{{ req.fromName }}</strong></div>
        </div>
        <div class="req-actions">
          <button class="btn-play" (click)="handleSongRequest(req)" matTooltip="Play Now">
            <mat-icon>play_arrow</mat-icon>
          </button>
          <button class="btn-remove" (click)="removeRequest(req)" matTooltip="Dismiss">
            <mat-icon>close</mat-icon>
          </button>
        </div>
      </div>
      <div *ngIf="spotifyRequests.length === 0" class="empty-requests">
        No active requests.
      </div>
    </div>
  </div>

  <!-- VTT Notification Overlay -->
  <div class="vtt-notification" *ngIf="showVttNotification">
    <div class="vtt-ping-card glass">
      <mat-icon>meeting_room</mat-icon>
      <div class="vtt-text">
        <strong>A VTT Session is active!</strong>
        <span>The host has started a session.</span>
      </div>
      <button class="btn-join-vtt" (click)="startVttJoining()">Join VTT</button>
      <button class="btn-close-vtt" (click)="showVttNotification = false">
        <mat-icon>close</mat-icon>
      </button>
    </div>
  </div>

  <!-- BROADCAST OVERLAY -->
  <div class="broadcast-overlay" *ngIf="activeOverlayImage || activeOverlayText">
    <div class="broadcast-image-container glass" *ngIf="activeOverlayImage">
      <img [src]="activeOverlayImage" alt="Broadcast Image">
      <button class="btn-dismiss" (click)="dismissOverlay()">
        <mat-icon>close</mat-icon>
        <span>Dismiss</span>
      </button>
    </div>

    <div class="broadcast-markdown-container glass" *ngIf="activeOverlayText">
      <markdown [data]="activeOverlayText"></markdown>
      <button class="btn-dismiss" (click)="dismissOverlay()">
        <mat-icon>close</mat-icon>
        <span>Dismiss</span>
      </button>
    </div>
  </div>

</div>
</file>

<file path="src/app/pages/dashboard/call/call.scss">
/* ================================
   VIDEO CALL (MODERN GLASS UI)
================================ */

.video-container {
  height: 100%;
  width: 100%;
  position: relative;
  background: rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
  container-type: inline-size;
}

/* =================================
   PRE-JOIN / SETUP SCREEN
================================= */

.pre-join-screen {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-l);
  background: radial-gradient(circle at center, rgba(114, 137, 218, 0.05) 0%, transparent 100%);
}

.setup-card {
  width: 100%;
  max-width: 600px;
  background: rgba(30, 31, 34, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid var(--outline);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-4);
}

.preview-area {
  width: 100%;
  aspect-ratio: 16/9;
  background: #000;
  position: relative;
  overflow: hidden;

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: rotateY(180deg);
    transition: opacity 0.3s ease;
    &.video-hidden { opacity: 0; }
  }

  .preview-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--on-surface-muted);
    gap: 12px;
    background: #1e1f22;
    mat-icon { font-size: 48px; width: 48px; height: 48px; }
    span { font-size: 14px; font-weight: 500; }
  }

  .preview-controls {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 16px;
    z-index: 10;
  }

  .btn-setup {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-round);
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    cursor: pointer;
    transition: all 0.2s ease;

    &:hover { background: rgba(255, 255, 255, 0.1); transform: translateY(-2px); }
    &.active { background: var(--danger); border-color: transparent; }
  }
}

.setup-content {
  padding: var(--space-l);
  text-align: center;
  h2 { font-size: 24px; font-weight: 700; margin-bottom: 8px; color: white; }
  p { font-size: 14px; color: var(--on-surface-muted); margin-bottom: 24px; }
}

/* Spotify Auth Prompt */
.spotify-auth-prompt {
  background: rgba(30, 215, 96, 0.05);
  border: 1px solid rgba(30, 215, 96, 0.2);
  border-radius: var(--radius-l);
  padding: 16px;
  margin-bottom: 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  transition: all 0.3s ease;

  &.connected {
    background: rgba(30, 215, 96, 0.1);
    border-color: rgba(30, 215, 96, 0.4);
  }

  .spotify-status {
    display: flex;
    align-items: center;
    gap: 12px;
    text-align: left;

    .spotify-icon-bg {
      width: 40px; height: 40px;
      background: #1DB954;
      border-radius: var(--radius-round);
      display: flex; align-items: center; justify-content: center;
      color: white;
      mat-icon { font-size: 20px; width: 20px; height: 20px; }
    }

    .status-text {
      display: flex; flex-direction: column;
      strong { font-size: 14px; color: white; }
      span { font-size: 12px; color: var(--on-surface-muted); }
    }
  }

  .btn-spotify-login {
    background: #1DB954;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    display: flex; align-items: center; gap: 8px;
    transition: all 0.2s ease;
    &:hover { background: #1ed760; transform: translateY(-1px); }
  }

  .connected-badge {
    display: flex; align-items: center; gap: 6px;
    color: #1DB954; font-weight: 700; font-size: 13px;
    mat-icon { font-size: 18px; width: 18px; height: 18px; }
  }
}

.settings-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 32px;
}

.device-select {
  display: flex;
  align-items: center;
  gap: 16px;
  background: var(--surface-light);
  border: 1px solid var(--outline);
  border-radius: var(--radius-l);
  padding: 0 16px;
  height: 48px;
  mat-icon { font-size: 20px; width: 20px; height: 20px; color: var(--brand-blue); }
  select {
    flex: 1;
    background: transparent;
    border: none;
    color: white;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    &:focus { outline: none; }
    option { background: #1e1f22; color: white; }
  }
}

.btn-primary-join {
  width: 100%;
  height: 52px;
  border-radius: var(--radius-l);
  background: var(--brand-blue);
  color: white;
  border: none;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  transition: all 0.2s ease;
  box-shadow: 0 4px 15px rgba(114, 137, 218, 0.3);
  &:hover { background: var(--brand-blue-hover); transform: translateY(-2px); box-shadow: 0 6px 20px rgba(114, 137, 218, 0.4); }
}

/* =================================
   DYNAMIC VIDEO GRID
================================= */

.grid {
  flex: 1;
  display: grid;
  gap: var(--space-m);
  padding: var(--space-m);
  width: 98%;
  height: 100%;
  overflow: hidden;
  justify-content: center;
  align-content: center;

  // LAYOUT LOGIC FOR 1-7 PEOPLE
  &.count-1 { grid-template-columns: 1fr; max-width: 1000px; margin: 0 auto; }
  &.count-2 { grid-template-columns: repeat(2, 1fr); align-content: center; }
  &.count-3 { grid-template-columns: repeat(2, 1fr); }
  &.count-4 { grid-template-columns: repeat(2, 1fr); }
  &.count-5, &.count-6 { grid-template-columns: repeat(3, 1fr); }
  &.count-7 { grid-template-columns: repeat(4, 1fr); }

  // Container Query Fallbacks for responsiveness to dashboard pane width
  @container (max-width: 900px) {
    &.count-5, &.count-6 { grid-template-columns: repeat(2, 1fr); }
    &.count-7 { grid-template-columns: repeat(3, 1fr); }
  }

  @container (max-width: 700px) {
    &.count-2, &.count-3, &.count-4 { grid-template-columns: 1fr; overflow-y: auto; align-content: start; }
    &.count-5, &.count-6, &.count-7 { grid-template-columns: repeat(2, 1fr); overflow-y: auto; align-content: start; }
  }

  @container (max-width: 450px) {
    &, &.count-1, &.count-2, &.count-3, &.count-4, &.count-5, &.count-6, &.count-7 {
      grid-template-columns: 1fr !important;
      overflow-y: auto;
      align-content: start;
    }
  }
}

.video-box {
  position: relative;
  background: #000;
  border-radius: var(--radius-l);
  overflow: hidden;
  border: 1px solid var(--outline);
  box-shadow: var(--shadow-2);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);

  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  max-height: 100%;
  place-self: center;

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  &.local video { transform: rotateY(180deg); }

  &:hover { transform: scale(1.02); border-color: var(--brand-blue-alpha); z-index: 10; }

  .video-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1e1f22;
    .user-avatar {
      width: min(20cqw, 80px);
