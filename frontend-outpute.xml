<file path="src/app/shared/services/tab/tab-service.ts">
import { Injectable } from '@angular/core';
import { BehaviorSubject } from 'rxjs';
import { ICharacter } from '../../models/user/character.model';
import { Video } from '../video/video';

export type TabType = 'text' | 'call' | 'character' | 'vtt' | 'spotify' | 'whisper' | 'obsidian';

export interface Tab {
  id: string;
  title: string;
  type: TabType;
  pane: 'left' | 'right';
  active: boolean;
  character?: ICharacter;
  whisperRecipient?: any;
  data?: any; // Added to support arbitrary data for different tab types
}

@Injectable({ providedIn: 'root' })
export class TabService {

  private readonly STORAGE_KEY = 'app_tabs';
  private tabs = new BehaviorSubject<Tab[]>([]);
  tabs$ = this.tabs.asObservable();

  constructor(private videoService: Video) {
    this.loadTabs();
  }

  private saveTabs(tabs: Tab[]) {
    localStorage.setItem(this.STORAGE_KEY, JSON.stringify(tabs));
  }

  private loadTabs() {
    const saved = localStorage.getItem(this.STORAGE_KEY);
    if (saved) {
      try {
        const tabs = JSON.parse(saved);
        this.tabs.next(tabs);
      } catch (e) {
        console.error('Failed to parse saved tabs', e);
      }
    }
  }

  openTab(id: string, title: string, type: TabType, pane: "left" | "right" = 'left', data?: any) { // Changed character to data
    const current = this.tabs.value;
    const existing = current.find(t => t.id === id);

    if (existing) {
      this.selectTab(id);
    } else {
      const newTab: Tab = { id, title, type, pane, active: true, data }; // Passed data to newTab
      // Deactivate others in the same pane
      const updated = current.map(t => t.pane === pane ? { ...t, active: false } : t);
      const res = [...updated.map(t=> (t.id === id ? {...t, active: true} : t))];
      if(!existing) res.push(newTab);
      this.tabs.next(res);
      this.saveTabs(res);
    }
  }

  selectTab(id: string) {
    const tabs = this.tabs.value;
    const target = tabs.find(t => t.id === id);
    if (!target) return;

    const updatedTabs = tabs.map(t => ({
      ...t,
      active: t.pane === target.pane ? t.id === id : t.active
    }));
    this.tabs.next(updatedTabs);
    this.saveTabs(updatedTabs);
  }

  moveTab(tabId: string, targetPane: 'left' | 'right') {
    const updatedTabs = this.tabs.value.map(t =>
      t.id === tabId ? { ...t, pane: targetPane, active: true } :
        (t.pane === targetPane ? { ...t, active: false } : t)
    );
    this.tabs.next(updatedTabs);
    this.saveTabs(updatedTabs);
  }

  closeTab(id: string) {
    const tabToClose = this.tabs.value.find(t => t.id === id);

    // Explicitly end the call if the user is closing a call tab
    if (tabToClose && tabToClose.type === 'call') {
      this.videoService.leaveCall(id);
    }

    const updatedTabs = this.tabs.value.filter(t => t.id !== id);
    this.tabs.next(updatedTabs);
    this.saveTabs(updatedTabs);
  }

  closeAllTabs() {
    this.tabs.value.forEach((tab=>{
        if (tab.type === 'call') {
          this.videoService.leaveCall(tab.id);
        }
    }))
    this.tabs.next([]);
    this.saveTabs([]);
  }

  updateTab(id: string, data: Partial<Tab>) {
    const current = this.tabs.value;
    const updated = current.map(t => t.id === id ? { ...t, ...data } : t);
    this.tabs.next(updated);
    this.saveTabs(updated);
  }
}
