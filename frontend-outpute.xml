<file path="src/app/pages/dashboard/obsidian-view/obsidian-view.component.html">
<div class="obsidian-view-container">
  <!-- Top Navigation Bar -->
  <div class="obsidian-header">
    <div class="left-section">
      <button mat-icon-button (click)="isEditing ? cancelEdit() : null" [disabled]="!isEditing" matTooltip="Back to vault">
        <mat-icon>arrow_back</mat-icon>
      </button>
      <div class="vault-info">
        <span class="vault-name">{{ vaultName || serverId }}</span>
      </div>
    </div>

    <div class="right-section">
      <!-- Broadcast Document Button -->
      <button *ngIf="isEditing"
              mat-icon-button
              (click)="broadcastCurrentContent()"
              [matTooltip]="hasBroadcastSelection ? 'Broadcast Selection' : 'Broadcast Document'">
        <mat-icon>broadcast_on_home</mat-icon>
      </button>

      <button *ngIf="localhostRoute" mat-icon-button (click)="openObsidianVault()" matTooltip="Open in Obsidian">
        <mat-icon>open_in_new</mat-icon>
      </button>

      <ng-container *ngIf="isEditing && selectedFileName.endsWith('.md')">
        <button mat-icon-button (click)="toggleEditMode()" [matTooltip]="isPreview ? 'Edit Source' : 'Show Preview'">
          <mat-icon>{{ isPreview ? 'edit' : 'visibility' }}</mat-icon>
        </button>
      </ng-container>
    </div>
  </div>

  <div class="obsidian-main-content">
    <!-- Sidebar - File Explorer -->
    <div class="obsidian-sidebar" [class.collapsed]="isEditing && !isPreview"
         [class.root-drop-target]="dropTargetIsRoot"
         (dragover)="onDragOver($event)"
         (dragleave)="dropTargetIsRoot = false"
         (drop)="onDrop($event)">
      <div class="sidebar-header">
        <div class="sidebar-title-block">
          <span class="sidebar-eyebrow">Vault explorer</span>
          <span class="sidebar-title">Files</span>
        </div>
        <div class="sidebar-actions">
          <button mat-icon-button
                  [matMenuTriggerFor]="createEntryMenu"
                  #createFolderTrigger="matMenuTrigger"
                  (click)="openCreatePopover('folder', createFolderTrigger)"
                  matTooltip="New Folder">
            <mat-icon>create_new_folder</mat-icon>
          </button>
          <button mat-icon-button
                  [matMenuTriggerFor]="createEntryMenu"
                  #createFileTrigger="matMenuTrigger"
                  (click)="openCreatePopover('file', createFileTrigger)"
                  matTooltip="New Note">
            <mat-icon>note_add</mat-icon>
          </button>
          <button mat-icon-button (click)="loadVaultEntries()" matTooltip="Refresh">
            <mat-icon>refresh</mat-icon>
          </button>
        </div>
      </div>

      <div class="file-tree">
        <mat-menu #createEntryMenu="matMenu" class="obsidian-create-entry-menu" xPosition="after" yPosition="below">
          <div class="obsidian-create-entry-popover" (click)="$event.stopPropagation()">
            <div class="create-entry-header">
              <h4>{{ createEntryMode === 'file' ? 'Create Note' : 'Create Folder' }}</h4>
              <p>{{ createEntryMode === 'file' ? 'Add a new markdown note. Optionally start from a template.' : 'Add a new folder to the vault.' }}</p>
            </div>

            <label class="create-entry-label">
              <span>{{ createEntryMode === 'file' ? 'Note name' : 'Folder name' }}</span>
              <input [(ngModel)]="newEntryName"
                     (keydown.enter)="submitCreateEntry(createEntryMode === 'file' ? createFileTrigger : createFolderTrigger)"
                     placeholder="{{ createEntryMode === 'file' ? 'New note' : 'New folder' }}"
                     spellcheck="false">
            </label>

            <label class="create-entry-label" *ngIf="createEntryMode === 'file'">
              <span>Template</span>
              <mat-select [(ngModel)]="selectedTemplateName">
                <mat-option value="">Blank note</mat-option>
                <mat-option *ngFor="let template of noteTemplates" [value]="template">
                  {{ template.replace('.md', '') }}
                </mat-option>
              </mat-select>
            </label>

            <div class="create-entry-actions">
              <button mat-stroked-button type="button" (click)="closeCreatePopover(createEntryMode === 'file' ? createFileTrigger : createFolderTrigger)">
                Cancel
              </button>
              <button mat-flat-button color="primary" type="button" (click)="submitCreateEntry(createEntryMode === 'file' ? createFileTrigger : createFolderTrigger)">
                {{ createEntryMode === 'file' ? 'Create Note' : 'Create Folder' }}
              </button>
            </div>
          </div>
        </mat-menu>

        <div class="root-drop-zone"
             [class.active]="dropTargetIsRoot"
             (dragover)="onRootDragOver($event)"
             (dragleave)="onRootDragLeave($event)"
             (drop)="onRootDrop($event)">
          <mat-icon>inventory_2</mat-icon>
          <div class="root-drop-text">
            <span class="root-drop-title">Vault Root</span>
            <span class="root-drop-subtitle">Drop here to move an item back to the top level</span>
          </div>
        </div>

        <mat-nav-list class="tree-root">
          <ng-container *ngTemplateOutlet="treeNode; context: { entries: vaultEntries }"></ng-container>
        </mat-nav-list>

        <!-- Recursive Node Template -->
        <ng-template #treeNode let-entries="entries" let-depth="depth">
          <div *ngFor="let entry of entries">
            <!-- Folder Node -->
            <mat-expansion-panel *ngIf="entry.kind === 'directory'"
                                 [hideToggle]="false"
                                 class="folder-panel"
                                 [class.drop-target]="currentDropTargetPath === entry.relativePath"
                                 [expanded]="isFolderExpanded(entry.relativePath)"
                                 draggable="true"
                                 (opened)="onFolderExpanded(entry.relativePath)"
                                 (closed)="onFolderCollapsed(entry.relativePath)"
                                 (dragstart)="onDragStart($event, entry)"
                                 (dragend)="onDragEnd()"
                                 (dragover)="onDragOver($event, entry)"
                                 (drop)="onDrop($event, entry)"
                                 (contextmenu)="onContextMenu($event, folderMenuTrigger)">
              <mat-expansion-panel-header [style.padding-left.px]="12 + ((depth || 0) * 18)">
                <mat-panel-title [title]="entry.relativePath">
                  <div class="entry-row">
                    <mat-icon>folder</mat-icon>
                    <span class="entry-name">{{ entry.name }}</span>
                  </div>
                </mat-panel-title>

                <!-- Hidden trigger for context menu -->
                <div [style.position]="'fixed'"
                     [style.left]="contextMenuPosition.x"
                     [style.top]="contextMenuPosition.y"
                     [matMenuTriggerFor]="folderMenu"
                     #folderMenuTrigger="matMenuTrigger">
                </div>

                <mat-menu #folderMenu="matMenu">
                  <button mat-menu-item (click)="deleteEntry(entry)">
                    <mat-icon>delete</mat-icon>
                    <span>Delete</span>
                  </button>
                </mat-menu>
              </mat-expansion-panel-header>

              <div class="folder-content">
                <ng-container *ngTemplateOutlet="treeNode; context: { entries: entry.children, depth: (depth || 0) + 1 }"></ng-container>
              </div>
            </mat-expansion-panel>

            <!-- File Node -->
            <mat-list-item *ngIf="entry.kind === 'file'"
                           (click)="selectFile(entry)"
                           (contextmenu)="onContextMenu($event, fileMenuTrigger)"
                           class="file-item"
                           [class.active]="selectedFileRelativePath === entry.relativePath"
                           [style.padding-left.px]="12 + ((depth || 0) * 18)"
                           draggable="true"
                           (dragstart)="onDragStart($event, entry)"
                           (dragend)="onDragEnd()">
              <mat-icon matListItemIcon>{{ entry.name.endsWith('.md') ? 'description' : 'insert_drive_file' }}</mat-icon>
              <div matListItemTitle [title]="entry.relativePath">{{ getEntryLabel(entry) }}</div>

              <!-- Hidden trigger for context menu -->
              <div [style.position]="'fixed'"
                   [style.left]="contextMenuPosition.x"
                   [style.top]="contextMenuPosition.y"
                   [matMenuTriggerFor]="fileMenu"
                   #fileMenuTrigger="matMenuTrigger">
              </div>

              <mat-menu #fileMenu="matMenu">
                <!-- Broadcast File Menu Item -->
                <button mat-menu-item (click)="selectFile(entry); broadcastFullDocument()">
                   <mat-icon>broadcast_on_home</mat-icon>
                   <span>Broadcast</span>
                </button>
                <button mat-menu-item (click)="deleteEntry(entry)">
                  <mat-icon>delete</mat-icon>
                  <span>Delete</span>
                </button>
              </mat-menu>
            </mat-list-item>
          </div>
        </ng-template>

        <div *ngIf="vaultEntries.length === 0 && permissionGranted" class="empty-state">
          <p>Empty vault.</p>
        </div>
      </div>
    </div>

    <!-- Main Content Area -->
    <div class="obsidian-editor-container">
      <!-- Welcome / Permission States -->
      <div *ngIf="!isEditing" class="welcome-screen">
        <div *ngIf="vaultName && !permissionGranted" class="setup-card">
          <mat-icon>lock</mat-icon>
          <h3>Access Required</h3>
          <p>Grant permission to access <strong>{{ vaultName }}</strong>.</p>

          <div class="browser-info">
            <mat-icon>info_outline</mat-icon>
            <p>Due to browser security policies, you must re-authorize access to local folders after page refreshes.</p>
          </div>

          <button mat-raised-button color="primary" (click)="requestPermission()">Grant Access</button>
        </div>

        <div *ngIf="!vaultName && !localhostRoute" class="setup-card">
          <mat-icon>folder_open</mat-icon>
          <h3>Setup Vault</h3>
          <p>Link your Obsidian vault to this server.</p>

          <div class="browser-warning" *ngIf="!fileSystemApiSupported">
            <mat-icon>warning_amber</mat-icon>
            <p>Your current browser does not support the File System Access API. Please switch to a Chromium-based browser (Chrome, Edge, etc.) to use local folders.</p>
          </div>

          <div class="browser-info" *ngIf="fileSystemApiSupported">
            <mat-icon>info_outline</mat-icon>
            <p>Browsers run in a secure sandbox. Local folder access is limited and requires manual permission to maintain security.</p>
          </div>

          <div class="actions">
            <button mat-raised-button color="primary" (click)="attachVault()" [disabled]="!fileSystemApiSupported">
              Attach Local Folder
            </button>
          </div>
        </div>

        <div *ngIf="permissionGranted && !isEditing" class="no-file-selected">
          <mat-icon>description</mat-icon>
          <p>Select a file to view or edit</p>
        </div>
      </div>

      <!-- File Content / Editor -->
      <div *ngIf="isEditing" class="file-content-wrapper">
        <!-- File Name Bar (Editable) -->
        <div class="file-name-bar">
          <input [(ngModel)]="selectedFileDisplayName" (blur)="renameSelectedFile()"
                 placeholder="Untitled Note" spellcheck="false" class="file-title-input">
        </div>

        <div class="editor-toolbar" *ngIf="selectedFileName.endsWith('.md')">
          <div class="editor-mode-switch">
            <button mat-stroked-button type="button" [class.active]="!isPreview" (click)="setMarkdownView(false)">
              <mat-icon>edit_note</mat-icon>
              Write
            </button>
            <button mat-stroked-button type="button" [class.active]="isPreview" (click)="setMarkdownView(true)">
              <mat-icon>visibility</mat-icon>
              Preview
            </button>
          </div>

          <div class="editor-actions">
            <button mat-stroked-button
                    type="button"
                    (mousedown)="onEditorActionMouseDown($event)"
                    (click)="openResourcePicker()"
                    [disabled]="isPreview"
                    matTooltip="Choose an image or file to embed on the current line">
              <mat-icon>attach_file</mat-icon>
              Embed File
            </button>
            <button *ngFor="let action of editorActions"
                    mat-stroked-button
                    type="button"
                    (mousedown)="onEditorActionMouseDown($event)"
                    (click)="applyEditorAction(action.action)"
                    [disabled]="isPreview"
                    [matTooltip]="action.tooltip">
              <mat-icon>{{ action.icon }}</mat-icon>
              {{ action.label }}
            </button>
          </div>
        </div>

        <div class="content-scroll-container">
          <!-- Selection Broadcast Button (Float/Contextual) -->
          <div class="selection-actions-container">
            <button mat-mini-fab color="accent" (click)="broadcastSelection()" matTooltip="Broadcast Selection">
              <mat-icon>broadcast_on_home</mat-icon>
            </button>
          </div>

          <!-- Markdown Previewer -->
          <div class="preview-mode" *ngIf="isPreview && selectedFileName.endsWith('.md')">
            <markdown [data]="processedContent"
                      class="obsidian-markdown"
                      (click)="handleMarkdownClick($event)"
                      (contextmenu)="handleMarkdownContextMenu($event)"></markdown>
          </div>

          <!-- Code/Markdown Editor -->
          <div class="editor-mode" *ngIf="!isPreview && selectedFileName.endsWith('.md')">
            <div class="editor-guidance">
              <div class="editor-intro">
                <h3>Write first, format when needed</h3>
                <p>Use the buttons above to add headings, lists, links, and other formatting without remembering Markdown symbols.</p>
              </div>

              <div class="tip-grid">
                <div class="tip-card" *ngFor="let tip of markdownTips">
                  <h4>{{ tip.title }}</h4>
                  <p>{{ tip.description }}</p>
                </div>
              </div>
            </div>

            <div class="resource-picker" *ngIf="resourcePickerOpen">
              <div class="resource-picker-header">
                <div>
                  <h4>Embed a file</h4>
                  <p>Select an image or resource file to insert as an Obsidian embed on the current line.</p>
                </div>
                <button mat-icon-button type="button" (click)="closeResourcePicker()" matTooltip="Close picker">
                  <mat-icon>close</mat-icon>
                </button>
              </div>

              <div class="resource-picker-search">
                <mat-icon>search</mat-icon>
                <input [(ngModel)]="resourceSearch"
                       placeholder="Search by file name or path"
                       spellcheck="false">
              </div>

              <div class="resource-picker-list" *ngIf="filteredResourceFiles.length; else noResourceFiles">
                <button class="resource-item"
                        type="button"
                        *ngFor="let file of filteredResourceFiles"
                        (click)="insertResourceEmbed(file)">
                  <mat-icon>{{ isImageFile(file.name) ? 'image' : (isPdfFile(file.name) ? 'picture_as_pdf' : 'attach_file') }}</mat-icon>
                  <div class="resource-item-text">
                    <span class="resource-name">{{ file.name }}</span>
                    <span class="resource-path">{{ file.relativePath }}</span>
                  </div>
                </button>
              </div>

              <ng-template #noResourceFiles>
                <div class="resource-picker-empty">
                  <mat-icon>perm_media</mat-icon>
                  <p>No matching resource files found.</p>
                </div>
              </ng-template>
            </div>

            <textarea #markdownEditor
                      [(ngModel)]="selectedFileContent"
                      (ngModelChange)="onContentChange()"
                      (input)="trackEditorSelection()"
                      (select)="trackEditorSelection()"
                      (click)="trackEditorSelection()"
                      (keyup)="trackEditorSelection()"
                      (scroll)="trackEditorSelection()"
                      placeholder="Start writing your note here. You can keep it plain and use the formatting buttons whenever you need them."
                      spellcheck="true"></textarea>
          </div>

          <!-- Non-markdown viewer -->
          <div class="non-markdown-viewer" *ngIf="!selectedFileName.endsWith('.md')">
            <img *ngIf="isImage" [src]="nonMarkdownUrl" class="viewer-image" (contextmenu)="handleImageContextMenu($event)">
            <embed *ngIf="isPdf" [src]="nonMarkdownUrl" type="application/pdf" class="viewer-pdf">
            <div *ngIf="!isImage && !isPdf" class="generic-file">
              <mat-icon>insert_drive_file</mat-icon>
              <p>{{ selectedFileName }}</p>
              <a [href]="nonMarkdownUrl" [download]="selectedFileName" mat-raised-button color="primary">Download File</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
